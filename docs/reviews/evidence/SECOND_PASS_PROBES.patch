@@ -0,0 +1,8 @@
+package score
+import("testing";"github.com/ghassan-ai-projects/streams-simulator/internal/model")
+func TestArchitectureReviewProbe(t *testing.T) {
+ at:=model.DefaultStartTimeNS
+ v:=&model.Verdict{RunID:"r-probe",Detections:[]model.Detection{{EntityID:"e",DetectedAt:model.FormatTime(at+20e9),Label:"wrong"},{EntityID:"e",DetectedAt:model.FormatTime(at+10e9),Label:"right"}}}
+ gt:=&model.GroundTruthRecord{EntityID:"e",FirstObservableTimeNS:at,Label:"right"}
+ sc:=Offline(v,gt,nil,nil,nil); if sc.Judgment.DetectionLatencyNS!=20e9 {t.Fatalf("unexpected probe result %+v",sc.Judgment)}; t.Logf("later-first ordering chooses latency=%d label_correct=%v",sc.Judgment.DetectionLatencyNS,sc.Judgment.LabelCorrect)
+}
