+package cli
+import("testing";"os";"path/filepath")
+func TestArchitectureReviewProbe(t *testing.T) {
+ dir:=t.TempDir(); for _,name:=range []string{"verdict.json","label.json"} {if e:=os.WriteFile(filepath.Join(dir,name),[]byte("{}"),0600); e!=nil {t.Fatal(e)}}
+ if e:=os.WriteFile(filepath.Join(dir,"ledger.jsonl"),nil,0600);e!=nil {t.Fatal(e)}; p:=filepath.Join(dir,"run.json"); if e:=os.WriteFile(p,[]byte("not JSON"),0600);e!=nil {t.Fatal(e)}
+ if e:=cmdScore([]string{"--run",p});e!=nil {t.Fatalf("unexpected probe result %v",e)}; t.Log("score succeeded with invalid artifact and empty verdict/label")
+}
