+package run
+import("testing";"path/filepath";"github.com/ghassan-ai-projects/streams-simulator/internal/model")
+func TestArchitectureReviewProbe(t *testing.T) {
+ spec,a:=testBase(t); r,e:=New(t.Context(),Config{Domain:spec,Adapter:a,SinkName:model.SinkInproc,LedgerPath:filepath.Join(t.TempDir(),"ledger.jsonl")});if e!=nil {t.Fatal(e)}
+ defer r.ledgerFile.Close()
+ if _,e=r.End(t.TempDir());e!=nil {t.Fatal(e)}
+ if _,e=r.ledgerFile.Stat();e!=nil {t.Fatalf("unexpected closed descriptor: %v",e)};t.Log("ledger descriptor remains open after successful End")
+}
