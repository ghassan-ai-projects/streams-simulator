{
  "id": "cold-chain-transit",
  "version": "0.1.0",
  "title": "Cold-chain reefer transit",
  "description": "Twelve refrigerated containers (reefers) crossing an ocean. For ~14 hours at sea a unit reports nothing (no cellular over deep water), then reconnects and dumps ~840 buffered readings at one arrival instant, every event-time in the past. The regulatory question is not 'is it cold now' but 'was cumulative time above -18 C more than 4 hours across the whole voyage' - and the answer depends on every one of the late readings. The domain that makes gross store-and-forward lateness (Q1) and normal-vs-broken absence (absence: normal) first-class.",
  "axes": {
    "absence": "normal",
    "actuation": "advisory",
    "cadence": ["periodic", "event_driven"],
    "cardinality": "fleet",
    "consequence": ["regulatory"],
    "correlation": ["independent"],
    "fidelity": ["F1"],
    "lateness": "gross",
    "rate": "low",
    "seasonality": ["none"],
    "time_reference": "wall",
    "value_shape": ["scalar", "enum", "boolean"]
  },
  "stresses": "Store-and-forward birth bursts, and regulatory excursion accounting that must survive them. After 14 hours of ocean silence the unit reconnects and dumps 840 buffered readings at one arrival instant, all with event times in the past - every one beyond any sane lateness allowance, yet the regulatory question depends on all of them. Absence is normal at sea (silence must not alarm), so a genuinely dead unit must be told apart by 'reporting is due', not by silence. The strongest test in the catalog that late_beyond_allowance evidence must remain visible to the reasoner rather than merely counted.",
  "kinds": [
    {
      "name": "reefer",
      "state": [
        {
          "name": "setpoint_true",
          "unit": "degC",
          "initial": -20.0,
          "min": -30.0,
          "max": 10.0,
          "description": "Commanded temperature. No free dynamics: moved only by the adjust_setpoint effector."
        },
        {
          "name": "fan_duty_true",
          "unit": "permille",
          "initial": 0.0,
          "min": 0.0,
          "max": 1000.0,
          "description": "Emulated low-voltage fan output. It is changed only by the explicit device-world fan effectors."
        },
        {
          "name": "led_brightness_true",
          "unit": "permille",
          "initial": 0.0,
          "min": 0.0,
          "max": 1000.0,
          "description": "Emulated low-voltage indicator output used as the first bounded device-loop effect."
        },
        {
          "name": "ambient_true",
          "unit": "degC",
          "initial": 12.0,
          "min": -5.0,
          "max": 45.0,
          "description": "Outside temperature. Mild diurnal swing at sea; warmer in port. Explains a rise without a fault."
        },
        {
          "name": "door_open",
          "unit": "rel",
          "initial": 0.0,
          "min": 0.0,
          "max": 1.0,
          "description": "0/1. No free dynamics: moved by the transient_none (legitimate 4-minute stop) and door_seal_leak faults."
        },
        {
          "name": "defrost_active",
          "unit": "rel",
          "initial": 0.0,
          "min": 0.0,
          "max": 1.0,
          "description": "0/1. Scheduled defrosts transiently warm the coil; defrost_stuck_on pins it on for ~2 h (the near-sensor-pathology case)."
        },
        {
          "name": "power_mode",
          "unit": "rel",
          "initial": 0.0,
          "min": 0.0,
          "max": 2.0,
          "description": "0=shore, 1=genset (at sea), 2=none. Moves on power_transfer_gap. genset => an offline stretch is expected."
        },
        {
          "name": "logged",
          "unit": "rel",
          "initial": 0.0,
          "min": 0.0,
          "max": 100.0,
          "description": "Advisory-effector ledger: request_inspection and raise_excursion_report bump it so their effect is observable to the world. No free dynamics."
        },
