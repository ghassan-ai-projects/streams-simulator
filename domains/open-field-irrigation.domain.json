{
  "id": "open-field-irrigation",
  "version": "0.1.0",
  "title": "Open-field irrigation control",
  "description": "Six irrigation zones fed by one pump station. The flow meter reports over a radio link whose readings arrive minutes to hours late; the soil-moisture probes stream nearly in real time on exception. Water applied cannot be recovered, so the false-positive cost is concrete: a zone over-irrigated on a bad reading is water and money gone. The gross-lateness domain: size a single lateness allowance for the slowest channel and every probe reading stays admissible forever.",
  "axes": {
    "absence": "signal",
    "actuation": "slow_physical",
    "cadence": ["periodic", "report_by_exception", "event_driven"],
    "cardinality": "fleet",
    "consequence": ["cost"],
    "correlation": ["spatial", "peer"],
    "fidelity": ["F1"],
    "lateness": "gross",
    "rate": "low",
    "seasonality": ["diurnal", "annual"],
    "time_reference": "wall",
    "value_shape": ["scalar", "enum"]
  },
  "stresses": "Cadence spans orders of magnitude on one entity, with gross lateness on the slowest channel: the flow meter's readings arrive minutes to hours late over the radio link while the soil-moisture probes stream in near real time on exception. A leak must be found in water that already ran. The domain most likely to force a design change in whatever consumes it.",
  "kinds": [
    {
      "name": "valve",
      "state": [
        {
          "name": "flow_rate_true",
          "unit": "L/min",
          "initial": 0.0,
          "min": 0.0,
          "max": 200.0,
          "description": "True delivered flow at the zone valve. A fast first-order lag behind valve position; a leak diverts water upstream so delivered flow falls short of what the valve says."
        },
        {
          "name": "pressure_true",
          "unit": "bar",
          "initial": 4.5,
          "min": 0.0,
          "max": 10.0,
          "description": "True header pressure at the valve. Collapses when the pump station loses head — the correlated-cascade root."
        },
        {
          "name": "soil_moisture_true",
          "unit": "percent",
          "initial": 25.0,
          "min": 0.0,
          "max": 100.0,
          "description": "True volumetric soil moisture. Dries on its own drift and on the diurnal evapotranspiration curve; a dry patch that self-recovers is the domain's false-positive trap."
        },
        {
          "name": "valve_position_true",
          "unit": "percent",
          "initial": 0.0,
          "min": 0.0,
          "max": 100.0,
          "description": "True valve opening. Piecewise: moved by the open/close effectors and by the valve_stuck and solenoid_failure faults. Drives the delivered flow."
        },
        {
          "name": "soil_sensor_bias",
          "unit": "rel",
          "initial": 0.0,
          "min": 0.0,
          "max": 1.0,
          "description": "Hidden drift of the soil-moisture probe. Corrupts the soil_moisture channel through its observation_bias: reads up to 15 points wet while the field dries."
        },
        {
          "name": "flow_sensor_bias",
          "unit": "rel",
          "initial": 0.0,
          "min": 0.0,
          "max": 1.0,
          "description": "Hidden failure state of the flow meter. Steps the flow reading up 40 L/min and collapses its variance — a flat line at a plausible value."
        }
      ],
      "dynamics": [
        {
          "target": "flow_rate_true",
          "tier": "F1",
          "dt_ms": 1000,
          "f1": {
            "form": "first_order_lag",
            "clamp": {"min": 0.0, "max": 200.0},
            "gain": 1.0,
            "inputs": [{"state": "valve_position_true", "coef": 1.2}],
            "time_constant_s": 30
          }
        },
        {
          "target": "pressure_true",
          "tier": "F0",
          "f0": {"baseline": 4.5, "drift_per_hour": 0.0, "trend_per_hour": 0.0}
        },
        {
          "target": "soil_moisture_true",
          "tier": "F0",
          "f0": {
            "baseline": 25.0,
            "drift_per_hour": 0.05,
            "seasonality": [
              {"amplitude": 4.0, "period_s": 86400, "phase_rad": 0.0},
              {"amplitude": 6.0, "period_s": 31536000, "phase_rad": 0.0}
            ],
            "trend_per_hour": 0.0
          }
        }
      ],
      "channels": [
        {
          "name": "flow_rate",
          "unit": "L/min",
          "absence": "signal",
          "availability": {"mttr_s": 1800, "uptime": 0.99},
          "cadence": {"jitter_s": 5, "mode": "periodic", "period_s": 60},
          "drift": {"model": "linear", "rate_per_hour": 0.0},
          "fidelity": "F1",
          "iso13374_role": "data_acquisition",
          "link_delay": {"max_s": 7200, "mean_s": 90, "model": "exponential", "sigma_s": 45},
          "noise": {"model": "gaussian", "sigma": 1.5},
          "observation_bias": {"state": "flow_sensor_bias", "coef": 40.0, "noise_scale_at_full": 0.05},
          "observes": "flow_rate_true",
          "range": {"min": 0.0, "max": 200.0},
          "resolution": 0.1,
          "value_type": "number",
          "description": "The radio-linked flow meter. Readings arrive minutes to hours late; the gross-lateness channel that breaks single-allowance consumers. Bias state makes it flat-line at a plausible value on failure."
        },
        {
          "name": "pressure",
          "unit": "bar",
          "absence": "signal",
          "cadence": {"jitter_s": 2, "mode": "periodic", "period_s": 60},
          "fidelity": "F0",
          "iso13374_role": "data_acquisition",
          "link_delay": {"max_s": 60, "mean_s": 5, "model": "exponential"},
          "noise": {"model": "gaussian", "sigma": 0.03},
          "observes": "pressure_true",
          "range": {"min": 0.0, "max": 10.0},
          "resolution": 0.01,
          "value_type": "number"
        },
        {
          "name": "soil_moisture",
          "unit": "percent",
          "absence": "normal",
          "cadence": {"deadband": 1.5, "mode": "report_by_exception", "period_s": 60},
          "fidelity": "F0",
          "iso13374_role": "data_acquisition",
          "link_delay": {"mean_s": 2.0, "model": "constant"},
          "noise": {"model": "gaussian", "sigma": 0.8},
          "observes": "soil_moisture_true",
          "range": {"min": 0.0, "max": 100.0},
          "resolution": 0.1,
          "value_type": "number",
          "description": "The probe string, reporting by exception: silence is steady state, a crossing is news. A consumer that treats silence as absence misreads this channel."
        },
        {
          "name": "valve_position",
          "unit": "percent",
          "absence": "signal",
          "cadence": {"jitter_s": 2, "mode": "periodic", "period_s": 60},
          "fidelity": "F0",
          "iso13374_role": "state_detection",
          "link_delay": {"mean_s": 5.0, "model": "constant"},
          "noise": {"model": "gaussian", "sigma": 0.5},
          "observes": "valve_position_true",
          "range": {"min": 0.0, "max": 100.0},
          "resolution": 0.1,
          "value_type": "number"
        },
        {
          "name": "status",
          "absence": "normal",
          "cadence": {"mode": "event_driven", "trigger_state": "valve_position_true"},
          "enum_values": ["closed", "opening", "open", "closing", "fault"],
          "fidelity": "F0",
          "iso13374_role": "data_manipulation",
          "link_delay": {"mean_s": 5.0, "model": "constant"},
          "noise": {"model": "none", "sigma": 0},
          "resolution": 1.0,
          "value_type": "string"
        },
        {
          "name": "heartbeat",
          "absence": "signal",
          "cadence": {"mode": "periodic", "period_s": 60},
          "fidelity": "F0",
          "iso13374_role": "data_acquisition",
          "link_delay": {"mean_s": 10.0, "model": "constant"},
          "noise": {"model": "none", "sigma": 0},
          "resolution": 1.0,
          "value_type": "none"
        }
      ],
      "faults": [
        {
          "id": "valve_stuck",
          "affects": [{"state": "valve_position_true", "delta": 70.0}],
          "counterfactual": {"if_action_by_deadline": "closed", "if_no_action": "water_loss"},
          "deadline_s": 3600,
          "expected_effector": "maintenance_reset",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "valve_position"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "The valve jams open at high opening. Water keeps running — an irreversible cost — until someone intervenes on site."
        },
        {
          "id": "pressure_loss",
          "affects": [{"state": "pressure_true", "delta": -2.5}],
          "counterfactual": {"if_action_by_deadline": "restored", "if_no_action": "under_irrigation"},
          "deadline_s": 3600,
          "expected_effector": "increase_pressure",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "pressure"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 2.5, "rate_per_hour": 0.4, "shape": "ramp"},
          "description": "The pump station loses head: pressure falls across every zone at once. The correlated root cause behind a storm of per-zone low-pressure alarms."
        },
        {
          "id": "soil_sensor_drift",
          "affects": [{"state": "soil_sensor_bias", "delta": 1.0}],
          "counterfactual": {"if_action_by_deadline": "recalibrated", "if_no_action": "over_irrigation"},
          "deadline_s": 7200,
          "expected_effector": "maintenance_reset",
          "observability": {
            "detector": {"form": "peer_residual", "channel": "soil_moisture"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "rate_per_hour": 0.2, "shape": "ramp"},
          "description": "The moisture probe drifts wet over hours: the field dries and the reading climbs. Every direct threshold on the probe is satisfied, and only the divergence from the diurnal expectation and the sibling zones betrays it. The instrument-lying label."
        },
        {
          "id": "flow_sensor_fault",
          "affects": [{"state": "flow_sensor_bias", "delta": 1.0}],
          "counterfactual": {"if_action_by_deadline": "repaired", "if_no_action": "blind_control"},
          "deadline_s": 3600,
          "expected_effector": "maintenance_reset",
          "observability": {
            "detector": {"form": "peer_residual", "channel": "flow_rate"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "The flow meter fails and flat-lines at a plausible reading: flow shows a steady 40 L/min while the valve sits closed. The conservation check against valve position is what catches it."
        },
        {
          "id": "leak",
          "affects": [{"state": "flow_rate_true", "delta": -12.0}],
          "counterfactual": {"if_action_by_deadline": "contained", "if_no_action": "water_loss"},
          "deadline_s": 1800,
          "expected_effector": "close_valve",
          "observability": {
            "detector": {"form": "conservation_residual", "inputs": ["flow_rate"], "outputs": ["valve_position"]},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 12.0, "rate_per_hour": 0.3, "shape": "ramp"},
          "description": "A line ruptures between the meter and the valve: delivered flow falls short of what the valve opening says, because water is leaving the system unmeasured. No single channel is wrong; the imbalance across the balance equation is the only evidence."
        },
        {
          "id": "solenoid_failure",
          "affects": [{"state": "valve_position_true", "delta": 30.0}],
          "counterfactual": {"if_action_by_deadline": "closed", "if_no_action": "uncontrolled_watering"},
          "deadline_s": 1800,
          "expected_effector": "close_valve",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "valve_position"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "The zone solenoid opens on its own under a control glitch: the valve moves without a command and the zone waters itself. A genuine fault with an obvious signature and a hard cost attached to acting late."
        },
        {
          "id": "dry_zone_none",
          "affects": [{"state": "soil_moisture_true", "delta": -8.0}],
          "is_negative_class": true,
          "observability": {
            "detector": {"form": "peer_residual", "channel": "soil_moisture"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"duty_cycle": 0.25, "magnitude": 8.0, "rate_per_hour": 2.0, "shape": "intermittent"},
          "description": "A dry patch from uneven rainfall: moisture reads low against the sibling zones for a day and recovers on its own. The false-positive trap — it looks exactly like the start of an irrigation failure."
        }
      ],
      "effectors": [
        {
          "name": "open_valve",
          "ack": {
            "failure_modes": [
              {"mode": "ok", "probability": 0.9},
              {"mode": "slow", "probability": 0.04},
              {"mode": "ack_lost", "probability": 0.02},
              {"mode": "reject", "probability": 0.02},
              {"mode": "confirmed_no_effect", "probability": 0.01},
              {"mode": "silent_no_effect", "probability": 0.01}
            ],
            "latency_ms": {"mean": 500, "sigma": 150}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {
              "position": {"maximum": 100, "minimum": 0, "type": "number"},
              "valve_id": {"type": "string"},
              "zone_id": {"type": "string"}
            },
            "required": ["zone_id", "valve_id", "position"],
            "type": "object"
          },
          "confirmation_channels": ["valve_position"],
          "effect": {
            "dead_time_s": 0,
            "state_deltas": [{"state": "valve_position_true", "delta": 1.0, "from_arg": "position"}],
            "time_constant_s": 120
          },
          "idempotency_window_s": 300,
          "risk_class": "low",
          "description": "Open the zone valve to a requested position. Flow follows within a minute; the valve's own feedback is the confirmation that the command landed."
        },
        {
          "name": "close_valve",
          "ack": {
            "failure_modes": [{"mode": "ok", "probability": 0.97}, {"mode": "ack_lost", "probability": 0.03}],
            "latency_ms": {"mean": 400, "sigma": 100}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {"valve_id": {"type": "string"}, "zone_id": {"type": "string"}},
            "required": ["zone_id", "valve_id"],
            "type": "object"
          },
          "effect": {
            "dead_time_s": 0,
            "state_deltas": [{"state": "valve_position_true", "delta": -80.0}],
            "time_constant_s": 120
          },
          "idempotency_window_s": 300,
          "risk_class": "low",
          "description": "Close the zone valve. The expensive remedy when the false positive was a real leak alarm: water that was never delivered is the cost of the mistake."
        },
        {
          "name": "increase_pressure",
          "ack": {
            "failure_modes": [
              {"mode": "ok", "probability": 0.95},
              {"mode": "slow", "probability": 0.02},
              {"mode": "ack_lost", "probability": 0.02},
              {"mode": "reject", "probability": 0.01}
            ],
            "latency_ms": {"mean": 600, "sigma": 200}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {"target_bar": {"maximum": 8, "minimum": 1, "type": "number"}, "zone_id": {"type": "string"}},
            "required": ["zone_id"],
            "type": "object"
          },
          "effect": {
            "dead_time_s": 0,
            "state_deltas": [{"state": "pressure_true", "delta": 1.0}],
            "time_constant_s": 180
          },
          "idempotency_window_s": 600,
          "risk_class": "medium",
          "description": "Raise the pump station setpoint: header pressure climbs over a couple of minutes."
        },
        {
          "name": "maintenance_reset",
          "ack": {
            "failure_modes": [
              {"mode": "ok", "probability": 0.95},
              {"mode": "ack_lost", "probability": 0.03},
              {"mode": "reject", "probability": 0.02}
            ],
            "latency_ms": {"mean": 700, "sigma": 200}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {"note": {"type": "string"}, "zone_id": {"type": "string"}},
            "required": ["zone_id"],
            "type": "object"
          },
          "effect": {
            "dead_time_s": 0,
            "state_deltas": [
              {"state": "soil_sensor_bias", "delta": -1.0},
              {"state": "flow_sensor_bias", "delta": -1.0},
              {"state": "valve_position_true", "delta": -10.0}
            ],
            "time_constant_s": 60
          },
          "idempotency_window_s": 1800,
          "risk_class": "medium",
          "description": "Zero the sensor bias states and re-seat the valve: recalibrates the probes that were lying and clears a mechanically stuck valve."
        }
      ]
    }
  ],
  "instances": [{"kind": "valve", "id_template": "zone-{zone}/valve-{n}", "count": {"default": 6, "min": 1, "max": 32}}],
  "profiles": [
    {
      "name": "nominal",
      "duration_s": 172800,
      "entity_count": 6,
      "description": "Six zones, one fault per scenario, 48-hour traces spanning two irrigation cycles."
    },
    {
      "name": "correlated_cascade",
      "duration_s": 21600,
      "entity_count": 6,
      "fault_weights": {"pressure_loss": 1.0},
      "simultaneous_entities": 6,
      "description": "The pump station trips: pressure collapses on every zone at once and each zone reports its own low-pressure alarm. The flood case for a consumer without an aggregate ceiling."
    },
    {
      "name": "sensor_pathology",
      "duration_s": 86400,
      "entity_count": 6,
      "fault_weights": {"dry_zone_none": 0.2, "flow_sensor_fault": 0.3, "soil_sensor_drift": 0.5},
      "description": "Weighted toward the instrument-lying labels: the moisture drift and the flat-line flow meter, with the dry patch as control. The labels a threshold rule cannot get right."
    }
  ],
  "ground_truth": {"min_per_label": 10, "min_scenarios": 100, "negative_class_fraction": 0.4, "pre_degraded_fraction": 0.12}
}
