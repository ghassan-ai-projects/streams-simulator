{
  "id": "k8s-cluster",
  "version": "0.1.0",
  "title": "Kubernetes cluster health",
  "description": "A cluster where pods are born and die continuously: 120 pod identities an hour with a 30-minute mean lifetime. Entity identity is ephemeral by design, so silence is meaningless without knowing whether the entity was supposed to still exist. The catalog targets 4,000 births per hour; this spec runs 120 per hour so a single-machine run stays usable while keeping the retirement behaviour — the capability most stream processors discover they lack — fully exercised.",
  "axes": {
    "absence": "ambiguous",
    "actuation": "fast_physical",
    "cadence": ["periodic", "event_driven"],
    "cardinality": "churning",
    "consequence": ["downtime"],
    "correlation": ["cascading", "peer"],
    "fidelity": ["F0"],
    "lateness": "bounded",
    "rate": "medium",
    "seasonality": ["diurnal"],
    "time_reference": "wall",
    "value_shape": ["scalar", "counter", "enum"]
  },
  "stresses": "Entity identity is ephemeral by design, so silence is meaningless without knowing whether the entity was supposed to still exist: a pod that stops reporting was probably scaled down on purpose. A consumer holding durable per-entity state with a wake schedule accumulates orphaned states and absence alarms against entities that were correctly deleted. Entity retirement is the concept most designs discover they lack.",
  "kinds": [
    {
      "name": "pod",
      "state": [
        {
          "name": "resource_usage_true",
          "unit": "percent",
          "initial": 55.0,
          "min": 0.0,
          "max": 100.0,
          "description": "True CPU/memory composite utilisation of the pod. Diurnal workload curve; dropped to near zero when the pod is evicted or its metrics path is severed."
        },
        {
          "name": "restarts_true",
          "unit": "count",
          "initial": 0.0,
          "min": 0.0,
          "max": 1000.0,
          "description": "True cumulative restart count of the pod. Steps up in bursts under crash_loop; a counter whose rate is the diagnosis and whose absolute value means nothing across pods."
        },
        {
          "name": "pod_phase",
          "unit": "rel",
          "initial": 1.0,
          "min": 0.0,
          "max": 1.0,
          "description": "Whether the pod is scheduled and running. No free dynamics: stepped to zero by evictions and drains. The trigger for the event-driven status channel."
        },
        {
          "name": "net_health",
          "unit": "rel",
          "initial": 1.0,
          "min": 0.0,
          "max": 1.0,
          "description": "Whether the pod's network path is intact. No free dynamics: stepped to zero by network_partition. The root of the metric-silence signature."
        },
        {
          "name": "config_bias",
          "unit": "rel",
          "initial": 0.0,
          "min": 0.0,
          "max": 1.0,
          "description": "Hidden staleness of the pod's declared resource limits. Corrupts the resource_usage channel through its observation_bias: reads up to 20 points high while the pod is actually healthy."
        }
      ],
      "dynamics": [
        {
          "target": "resource_usage_true",
          "tier": "F0",
          "f0": {
            "baseline": 55.0,
            "drift_per_hour": 0.0,
            "seasonality": [{"amplitude": 12.0, "period_s": 86400, "phase_rad": 0.0}],
            "trend_per_hour": 0.0
          }
        },
        {
          "target": "restarts_true",
          "tier": "F0",
          "f0": {"baseline": 0.0, "drift_per_hour": 0.0, "trend_per_hour": 0.0}
        }
      ],
      "channels": [
        {
          "name": "resource_usage",
          "unit": "percent",
          "absence": "ambiguous",
          "availability": {"mttr_s": 300, "uptime": 0.995},
          "cadence": {"jitter_s": 2, "mode": "periodic", "period_s": 60},
          "drift": {"model": "linear", "rate_per_hour": 0.0},
          "fidelity": "F0",
          "iso13374_role": "data_acquisition",
          "link_delay": {"max_s": 10, "mean_s": 0.5, "model": "exponential"},
          "noise": {"model": "gaussian", "sigma": 1.0},
          "observation_bias": {"state": "config_bias", "coef": 20.0, "noise_scale_at_full": 0.4},
          "observes": "resource_usage_true",
          "range": {"min": 0.0, "max": 100.0},
          "resolution": 0.1,
          "value_type": "number",
          "description": "The pod metrics sample. Stops moving when the pod dies or its metrics path is severed, which is exactly why a consumer must know whether the entity is supposed to exist."
        },
        {
          "name": "restarts",
          "unit": "count",
          "absence": "ambiguous",
          "cadence": {"mode": "periodic", "period_s": 60},
          "fidelity": "F0",
          "iso13374_role": "data_acquisition",
          "link_delay": {"max_s": 10, "mean_s": 0.5, "model": "exponential"},
          "noise": {"model": "quantization", "sigma": 1.0},
          "observes": "restarts_true",
          "range": {"min": 0.0, "max": 1000.0},
          "resolution": 1.0,
          "value_type": "counter"
        },
        {
          "name": "status",
          "absence": "ambiguous",
          "cadence": {"mode": "event_driven", "trigger_state": "pod_phase"},
          "enum_values": ["pending", "running", "crashloop", "evicted", "ready"],
          "fidelity": "F0",
          "iso13374_role": "data_manipulation",
          "link_delay": {"mean_s": 1.0, "model": "constant"},
          "noise": {"model": "none", "sigma": 0},
          "resolution": 1.0,
          "value_type": "string"
        },
        {
          "name": "heartbeat",
          "absence": "ambiguous",
          "cadence": {"mode": "periodic", "period_s": 60},
          "fidelity": "F0",
          "iso13374_role": "data_acquisition",
          "link_delay": {"mean_s": 0.5, "model": "constant"},
          "noise": {"model": "none", "sigma": 0},
          "resolution": 1.0,
          "value_type": "none"
        }
      ],
      "faults": [
        {
          "id": "pod_eviction",
          "affects": [{"state": "pod_phase", "delta": -1.0}, {"state": "resource_usage_true", "delta": -40.0}],
          "counterfactual": {"if_action_by_deadline": "replicated", "if_no_action": "capacity_loss"},
          "deadline_s": 600,
          "expected_effector": "scale_replicas",
          "observability": {
            "detector": {"form": "peer_residual", "channel": "resource_usage"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "The pod is evicted under node pressure: phase drops and the metrics reading collapses to near zero. Looks exactly like a pod that was correctly deleted — the consumer that cannot tell the difference has no defence here."
        },
        {
          "id": "memory_thrash",
          "affects": [{"state": "resource_usage_true", "delta": 20.0}],
          "counterfactual": {"if_action_by_deadline": "rescheduled", "if_no_action": "node_pressure"},
          "deadline_s": 1800,
          "expected_effector": "evict_pod",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "resource_usage"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"duty_cycle": 0.3, "magnitude": 20.0, "rate_per_hour": 6.0, "shape": "intermittent"},
          "description": "The pod thrashes against its memory limit in pulses: usage spikes repeatedly and settles. Sustained, not a single event — a cooldown-aware consumer absorbs it, a naive one fights it."
        },
        {
          "id": "network_partition",
          "affects": [{"state": "net_health", "delta": -1.0}, {"state": "resource_usage_true", "delta": -45.0}],
          "counterfactual": {"if_action_by_deadline": "contained", "if_no_action": "stale_workload"},
          "deadline_s": 900,
          "expected_effector": "cordon_node",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "resource_usage"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "The pod's network path is severed: metrics stop flowing and the resource reading freezes low. The heartbeat continues from the out-of-band agent, so only the absent metric stream betrays the partition — silence with a known cause."
        },
        {
          "id": "crash_loop",
          "affects": [{"state": "restarts_true", "delta": 4.0}],
          "counterfactual": {"if_action_by_deadline": "broken", "if_no_action": "churn_storm"},
          "deadline_s": 1200,
          "expected_effector": "evict_pod",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "restarts"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "The pod's container crashes on startup and the restart counter climbs in bursts. The rate of the counter is the signal; its absolute level is meaningless across pods."
        },
        {
          "id": "node_drain",
          "affects": [{"state": "pod_phase", "delta": -1.0}, {"state": "resource_usage_true", "delta": -40.0}],
          "is_negative_class": true,
          "observability": {
            "detector": {"form": "peer_residual", "channel": "resource_usage"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"duty_cycle": 0.2, "magnitude": 1.0, "rate_per_hour": 3.0, "shape": "intermittent"},
          "description": "A scheduled node drain evicts pods legitimately: the pod is terminated because it was supposed to be, and the metrics reading collapses exactly as under pod_eviction. The false-positive trap — same signature, different truth."
        },
        {
          "id": "config_mismatch",
          "affects": [{"state": "config_bias", "delta": 1.0}],
          "counterfactual": {"if_action_by_deadline": "reconfigured", "if_no_action": "capacity_waste"},
          "deadline_s": 3600,
          "expected_effector": "evict_pod",
          "observability": {
            "detector": {"form": "peer_residual", "channel": "resource_usage"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "rate_per_hour": 0.2, "shape": "ramp"},
          "description": "The pod runs against stale resource limits: the metric reads up to 20 points high while the pod is actually healthy. Only the divergence from the sibling pods and the pod's own history betrays it — the instrument-lying label of this domain."
        }
      ],
      "effectors": [
        {
          "name": "evict_pod",
          "ack": {
            "failure_modes": [
              {"mode": "ok", "probability": 0.9},
              {"mode": "slow", "probability": 0.04},
              {"mode": "ack_lost", "probability": 0.03},
              {"mode": "reject", "probability": 0.03}
            ],
            "latency_ms": {"mean": 300, "sigma": 100}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {"cluster_id": {"type": "string"}, "pod_id": {"type": "string"}, "reason": {"type": "string"}},
            "required": ["cluster_id", "pod_id"],
            "type": "object"
          },
          "effect": {
            "dead_time_s": 0,
            "state_deltas": [{"state": "pod_phase", "delta": -1.0}, {"state": "resource_usage_true", "delta": -30.0}],
            "time_constant_s": 30
          },
          "idempotency_window_s": 60,
          "risk_class": "high",
          "description": "Force-evict the pod so it is rescheduled elsewhere. High-risk, high-cost: the remedy for a crashing or lying pod, and expensive when the call was wrong."
        },
        {
          "name": "scale_replicas",
          "ack": {
            "failure_modes": [
              {"mode": "ok", "probability": 0.95},
              {"mode": "slow", "probability": 0.02},
              {"mode": "ack_lost", "probability": 0.02},
              {"mode": "reject", "probability": 0.01}
            ],
            "latency_ms": {"mean": 400, "sigma": 120}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {
              "cluster_id": {"type": "string"},
              "deployment": {"type": "string"},
              "replicas": {"maximum": 64, "minimum": 1, "type": "integer"}
            },
            "required": ["cluster_id", "deployment"],
            "type": "object"
          },
          "effect": {
            "dead_time_s": 0,
            "state_deltas": [{"state": "resource_usage_true", "delta": -15.0}, {"state": "restarts_true", "delta": -2.0}],
            "time_constant_s": 120
          },
          "idempotency_window_s": 600,
          "risk_class": "low",
          "description": "Raise the replica count of the deployment backing the pod: load spreads and the observed usage falls as siblings take the work."
        },
        {
          "name": "cordon_node",
          "ack": {
            "failure_modes": [
              {"mode": "ok", "probability": 0.94},
              {"mode": "ack_lost", "probability": 0.03},
              {"mode": "reject", "probability": 0.03}
            ],
            "latency_ms": {"mean": 350, "sigma": 100}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {"cluster_id": {"type": "string"}, "node_id": {"type": "string"}},
            "required": ["cluster_id", "node_id"],
            "type": "object"
          },
          "effect": {
            "dead_time_s": 0,
            "state_deltas": [{"state": "resource_usage_true", "delta": -10.0}],
            "time_constant_s": 60
          },
          "idempotency_window_s": 300,
          "risk_class": "medium",
          "description": "Mark the node unschedulable so no new work lands on the partitioned path. Contains the blast radius; does not claim to fix the partition itself."
        }
      ]
    }
  ],
  "instances": [
    {
      "kind": "pod",
      "id_template": "cluster-{cluster}/pod-{n}",
      "count": {"default": 8, "min": 1, "max": 64},
      "churn": {"births_per_hour": 120, "mean_lifetime_s": 1800}
    }
  ],
  "profiles": [
    {
      "name": "nominal",
      "duration_s": 86400,
      "entity_count": 8,
      "description": "A base fleet of eight pods under continuous churn, one fault per scenario, 24-hour traces."
    },
    {
      "name": "correlated_cascade",
      "duration_s": 10800,
      "entity_count": 8,
      "fault_weights": {"crash_loop": 1.0},
      "simultaneous_entities": 8,
      "description": "A control-plane event flips many pods into crash-loop at once: eight restart counters climbing together. The alarm-flood case, and the one where per-entity restart-rate triggers each open their own episode."
    },
    {
      "name": "sensor_pathology",
      "duration_s": 43200,
      "entity_count": 8,
      "fault_weights": {"config_mismatch": 0.5, "network_partition": 0.3, "node_drain": 0.2},
      "description": "Weighted toward the lies: the stale-limit reading and the frozen metrics, with the legitimately-evicted pod as control. The labels a fixed threshold on resource usage cannot separate."
    }
  ],
  "ground_truth": {"min_per_label": 10, "min_scenarios": 100, "negative_class_fraction": 0.4, "pre_degraded_fraction": 0.12}
}
