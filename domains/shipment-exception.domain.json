{
  "id": "shipment-exception",
  "version": "0.1.0",
  "title": "Shipment exception and ETA forecast",
  "description": "Twelve shipments, one tenant, shared lanes. A shipment's fate is decided by parties that never talk to each other - the truck, the sort hub, the customs office, the line-haul carrier. Each sends its own updates on its own schedule; the runtime must fuse them into one honest ETA forecast, name the link that caused a slip (customs vs hub vs traffic), and act only when the whole remaining route says so. The subject is composed from events about OTHER entities - the fusion/attribution stress of Round 5 (not in the 25-domain catalog; modeled on #24 cicd-pipeline-health, zero physics).",
  "axes": {
    "absence": "signal",
    "actuation": "advisory",
    "cadence": ["event_driven", "periodic"],
    "cardinality": "fleet",
    "consequence": ["cost"],
    "correlation": ["cascading"],
    "fidelity": ["F0"],
    "lateness": "heavy_tail",
    "rate": "medium",
    "seasonality": ["weekly"],
    "time_reference": "wall",
    "value_shape": ["scalar", "enum", "counter"]
  },
  "stresses": "Heterogeneous cross-party stream fusion + forecast-to-deadline reasoning with cascading multi-leg dependencies. One shipment, a dozen sources: position, leg status, hub scans, customs, a carrier-provided ETA forecast that can lie (optimistic), and accrued leg delay. The reasoner must attribute the breach to the right link - not the loudest feed - and must not expedite a delay the remaining route absorbs. The forecast (eta_slack_min) is domain-precomputed so no CEL clock arithmetic is needed; the reasoning is WHY it is negative, and whether to trust it against the accumulated delay.",
  "kinds": [
    {
      "name": "shipment",
      "state": [
        {
          "name": "slack_true",
          "unit": "min",
          "initial": 240.0,
          "min": -600.0,
          "max": 1440.0,
          "description": "The REAL slack (carrier ETA minus promised window). Moved by the faults; the observed eta_slack_min channel reads it, biased high when carrier_eta_optimistic is active."
        },
        {
          "name": "route_buffer",
          "unit": "min",
          "initial": 90.0,
          "min": 0.0,
          "max": 1440.0,
          "description": "Minutes of slack left on the REMAINING legs. What makes an absorbed delay possible: a leg delay smaller than the buffer does not breach the promise."
        },
        {
          "name": "promised_window",
          "unit": "min",
          "initial": 240.0,
          "min": 0.0,
          "max": 1440.0,
          "description": "Static per-shipment promise (carrier ETA at pickup + this window)."
        },
        {
          "name": "carrier_eta_bias",
          "unit": "min",
          "initial": 0.0,
          "min": -600.0,
          "max": 600.0,
          "description": "0 = honest ETA. carrier_eta_optimistic sets it positive (the observed slack reads HIGHER than reality - the forecast lies)."
        },
        {
          "name": "leg_delay_accrued",
          "unit": "min",
          "initial": 0.0,
          "min": 0.0,
          "max": 1440.0,
          "description": "Delay accrued on the current leg; the observed leg_delay_min channel reads it."
        },
        {
          "name": "position_true",
          "unit": "frac",
          "initial": 0.0,
          "min": 0.0,
          "max": 1.0,
          "description": "Route progress 0..1. Flat = stuck (lost_tracking freezes it and the heartbeat)."
        }
      ],
      "dynamics": [
        {
          "target": "slack_true",
          "tier": "F0",
          "f0": {"baseline": 240.0, "drift_per_hour": 0.0, "seasonality": []}
        },
        {
          "target": "route_buffer",
          "tier": "F0",
          "f0": {"baseline": 90.0, "drift_per_hour": 0.0, "seasonality": []}
        },
        {
          "target": "promised_window",
          "tier": "F0",
          "f0": {"baseline": 240.0, "drift_per_hour": 0.0, "seasonality": []}
        },
        {
          "target": "carrier_eta_bias",
          "tier": "F0",
          "f0": {"baseline": 0.0, "drift_per_hour": 0.0, "seasonality": []}
        },
        {
          "target": "leg_delay_accrued",
          "tier": "F0",
          "f0": {"baseline": 0.0, "drift_per_hour": 0.0, "seasonality": []}
        },
        {
          "target": "position_true",
          "tier": "F0",
          "f0": {"baseline": 0.0, "drift_per_hour": 0.0, "seasonality": []}
        }
      ],
      "channels": [
        {
          "name": "shipment.position",
          "unit": "frac",
          "absence": "signal",
          "cadence": {"jitter_s": 15, "mode": "periodic", "period_s": 300},
          "fidelity": "F0",
          "iso13374_role": "state_detection",
          "link_delay": {"mean_s": 2.0, "model": "constant"},
          "noise": {"model": "gaussian", "sigma": 0.005},
          "observes": "position_true",
          "range": {"min": 0.0, "max": 1.0},
          "resolution": 0.01,
          "value_type": "number",
          "description": "Route progress; flat = stuck."
        },
        {
          "name": "shipment.leg_status",
          "absence": "signal",
          "cadence": {"mode": "event_driven", "trigger_state": "position_true"},
          "enum_values": ["picked_up", "in_transit", "at_hub", "out_for_delivery", "delivered", "exception"],
          "fidelity": "F0",
          "iso13374_role": "data_manipulation",
          "link_delay": {"mean_s": 2.0, "model": "constant"},
          "noise": {"model": "none", "sigma": 0},
          "resolution": 1.0,
          "value_type": "string",
          "description": "Leg status; emits data.exception 1/0 for aggregation."
        },
        {
          "name": "shipment.hub_event",
          "absence": "signal",
          "cadence": {"mode": "event_driven", "trigger_state": "position_true"},
          "enum_values": ["arrived", "departed", "missort", "backlog"],
          "fidelity": "F0",
          "iso13374_role": "data_manipulation",
          "link_delay": {"mean_s": 2.0, "model": "constant"},
          "noise": {"model": "none", "sigma": 0},
          "resolution": 1.0,
          "value_type": "string",
          "description": "Sort-hub scans; emits data.trouble 1/0 for aggregation (missort/backlog)."
        },
        {
          "name": "shipment.customs_status",
          "absence": "signal",
          "cadence": {"mode": "event_driven", "trigger_state": "position_true"},
          "enum_values": ["not_started", "submitted", "cleared", "hold", "inspection"],
          "fidelity": "F0",
          "iso13374_role": "data_manipulation",
          "link_delay": {"mean_s": 2.0, "model": "constant"},
          "noise": {"model": "none", "sigma": 0},
          "resolution": 1.0,
          "value_type": "string",
          "description": "Border status; emits data.hold 1/0 for aggregation."
        },
        {
          "name": "shipment.eta_slack_min",
          "unit": "min",
          "absence": "signal",
          "cadence": {"mode": "event_driven", "trigger_state": "slack_true"},
          "fidelity": "F0",
          "iso13374_role": "state_detection",
          "link_delay": {"mean_s": 2.0, "model": "constant"},
          "noise": {"model": "gaussian", "sigma": 3.0},
          "observation_bias": {"state": "carrier_eta_bias", "coef": 1.0, "noise_scale_at_full": 0.0},
          "observes": "slack_true",
          "range": {"min": -600.0, "max": 1440.0},
          "resolution": 1.0,
          "value_type": "number",
          "description": "THE FORECAST: carrier ETA minus the promised window, minutes (negative = predicted late). Domain-precomputed; can be optimistic (carrier_eta_optimistic biases it above reality)."
        },
        {
          "name": "shipment.leg_delay_min",
          "unit": "min",
          "absence": "signal",
          "cadence": {"jitter_s": 15, "mode": "periodic", "period_s": 300},
          "fidelity": "F0",
          "iso13374_role": "state_detection",
          "link_delay": {"mean_s": 2.0, "model": "constant"},
          "noise": {"model": "gaussian", "sigma": 2.0},
          "observes": "leg_delay_accrued",
          "range": {"min": 0.0, "max": 1440.0},
          "resolution": 1.0,
          "value_type": "number",
          "description": "Delay accrued on the current leg."
        },
        {
          "name": "shipment.heartbeat",
          "absence": "signal",
          "cadence": {"mode": "periodic", "period_s": 60},
          "fidelity": "F0",
          "iso13374_role": "data_acquisition",
          "link_delay": {"mean_s": 0.5, "model": "constant"},
          "noise": {"model": "none", "sigma": 0},
          "resolution": 1.0,
          "value_type": "none"
        }
      ],
      "faults": [
        {
          "id": "customs_hold_delay",
          "affects": [{"state": "slack_true", "delta": -300.0}, {"state": "route_buffer", "delta": -300.0}],
          "counterfactual": {"if_action_by_deadline": "on_time", "if_no_action": "sla_penalty"},
          "deadline_s": 21600,
          "expected_effector": "expedite_shipment",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "shipment.eta_slack_min"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "A border hold cascades into the downstream legs: slack_true falls past the window (breach). The moment-5 cause the reasoner must NAME over the traffic feed."
        },
        {
          "id": "hub_backlog",
          "affects": [{"state": "slack_true", "delta": -90.0}, {"state": "route_buffer", "delta": -60.0}],
          "counterfactual": {"if_action_by_deadline": "on_time", "if_no_action": "sla_penalty"},
          "deadline_s": 43200,
          "expected_effector": "open_carrier_case",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "shipment.hub_event"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "A sort hub backs up: hub_event missort/backlog, hub_trouble accrues, slack tightens."
        },
        {
          "id": "traffic_delay_leg",
          "affects": [{"state": "leg_delay_accrued", "delta": 90.0}, {"state": "route_buffer", "delta": -90.0}],
          "counterfactual": {"if_action_by_deadline": "on_time", "if_no_action": "on_time_anyway"},
          "deadline_s": 43200,
          "expected_effector": "notify_customer",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "shipment.leg_delay_min"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 90.0, "rate_per_hour": 30.0, "shape": "ramp"},
          "description": "A leg delay the route can ABSORB: leg_delay spikes but route_buffer covers it and the ETA still fits. The confounder (moment 4) - a threshold on the loud leg would expedite an on-time shipment."
        },
        {
          "id": "lost_tracking",
          "affects": [{"state": "position_true", "delta": 0.0}],
          "counterfactual": {"if_action_by_deadline": "located", "if_no_action": "unseen_breach"},
          "deadline_s": 3600,
          "expected_effector": "escalate_to_operator",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "shipment.heartbeat"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "position + heartbeat stop mid-leg: the shipment cannot be seen. Fail-closed: a re-plan on an unseen shipment is denied (moment 2)."
        },
        {
          "id": "carrier_eta_optimistic",
          "affects": [{"state": "carrier_eta_bias", "delta": 150.0}],
          "counterfactual": {"if_action_by_deadline": "on_time", "if_no_action": "sla_penalty_undetected"},
          "deadline_s": 21600,
          "expected_effector": "open_carrier_case",
          "observability": {
            "detector": {
              "form": "channel_divergence",
              "channel_a": "shipment.eta_slack_min",
              "channel_b": "shipment.leg_delay_min"
            },
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "The forecast feed LIES: observed eta_slack_min reads above slack_true (the ETA under-reports the delay). Only the cross-check against accumulated leg_delay_min reveals it - the important cause has no single-channel signature."
        },
        {
          "id": "hub_outage_cascade",
          "affects": [{"state": "slack_true", "delta": -120.0}, {"state": "route_buffer", "delta": -120.0}],
          "counterfactual": {"if_action_by_deadline": "partial", "if_no_action": "cascade_penalty"},
          "deadline_s": 43200,
          "expected_effector": "open_carrier_case",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "shipment.eta_slack_min"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "shape": "step"},
          "description": "One hub delays every shipment routed through it at once: the synchronized episode storm (scale check) - should trip a consumer's cost ceiling while ingress and the action plane survive."
        },
        {
          "id": "transient_none",
          "affects": [{"state": "leg_delay_accrued", "delta": 60.0}],
          "is_negative_class": true,
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "shipment.leg_delay_min"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"duty_cycle": 0.1, "magnitude": 1.0, "shape": "intermittent"},
          "description": "A mid-journey delay fully absorbed downstream, delivered on time. The false-positive trap: the loud leg says delay, the whole route says fine."
        }
      ],
      "effectors": [
        {
          "name": "notify_customer",
          "ack": {
            "failure_modes": [{"mode": "ok", "probability": 0.98}, {"mode": "ack_lost", "probability": 0.02}],
            "latency_ms": {"mean": 200, "sigma": 60}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {"message": {"type": "string"}, "shipment_id": {"type": "string"}},
            "required": ["shipment_id"],
            "type": "object"
          },
          "effect": {"dead_time_s": 0, "state_deltas": [{"state": "route_buffer", "delta": 0.0}], "time_constant_s": 60},
          "idempotency_window_s": 3600,
          "risk_class": "low",
          "description": "Proactive plain heads-up. Cheap, buys goodwill."
        },
        {
          "name": "open_carrier_case",
          "ack": {
            "failure_modes": [{"mode": "ok", "probability": 0.97}, {"mode": "ack_lost", "probability": 0.03}],
            "latency_ms": {"mean": 250, "sigma": 60}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {"carrier": {"type": "string"}, "note": {"type": "string"}, "shipment_id": {"type": "string"}},
            "required": ["shipment_id"],
            "type": "object"
          },
          "effect": {"dead_time_s": 0, "state_deltas": [{"state": "route_buffer", "delta": 0.0}], "time_constant_s": 60},
          "idempotency_window_s": 3600,
          "risk_class": "low",
          "description": "Raise the exception with the responsible carrier."
        },
        {
          "name": "escalate_to_operator",
          "ack": {
            "failure_modes": [{"mode": "ok", "probability": 0.98}, {"mode": "ack_lost", "probability": 0.02}],
            "latency_ms": {"mean": 200, "sigma": 60}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {"note": {"type": "string"}, "shipment_id": {"type": "string"}},
            "required": ["shipment_id"],
            "type": "object"
          },
          "effect": {"dead_time_s": 0, "state_deltas": [{"state": "route_buffer", "delta": 0.0}], "time_constant_s": 60},
          "idempotency_window_s": 3600,
          "risk_class": "low",
          "description": "Hand a human the assembled story to act on."
        },
        {
          "name": "reroute_shipment",
          "ack": {
            "failure_modes": [
              {"mode": "ok", "probability": 0.88},
              {"mode": "partial", "probability": 0.07},
              {"mode": "reject", "probability": 0.05}
            ],
            "latency_ms": {"mean": 1200, "sigma": 300}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {"plan": {"type": "string"}, "shipment_id": {"type": "string"}},
            "required": ["shipment_id"],
            "type": "object"
          },
          "effect": {
            "dead_time_s": 120,
            "state_deltas": [{"state": "route_buffer", "delta": 60.0}],
            "time_constant_s": 600
          },
          "idempotency_window_s": 7200,
          "risk_class": "high",
          "description": "Commit a new plan + cost. High blast radius - human approval required (R2)."
        },
        {
          "name": "expedite_shipment",
          "ack": {
            "failure_modes": [
              {"mode": "ok", "probability": 0.88},
              {"mode": "partial", "probability": 0.07},
              {"mode": "reject", "probability": 0.05}
            ],
            "latency_ms": {"mean": 1500, "sigma": 400}
          },
          "args_schema": {
            "additionalProperties": false,
            "properties": {"service": {"type": "string"}, "shipment_id": {"type": "string"}},
            "required": ["shipment_id"],
            "type": "object"
          },
          "effect": {
            "dead_time_s": 120,
            "state_deltas": [{"state": "route_buffer", "delta": 90.0}],
            "time_constant_s": 600
          },
          "idempotency_window_s": 7200,
          "risk_class": "high",
          "description": "Pay to upgrade service. The false-positive cost that makes the negative class matter (R2, human approval)."
        }
      ]
    }
  ],
  "instances": [{"kind": "shipment", "id_template": "shipment-{n}", "count": {"default": 12, "min": 1, "max": 500}}],
