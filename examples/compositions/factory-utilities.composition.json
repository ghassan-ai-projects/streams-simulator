{
  "schema_version": "0.1",
  "id": "factory-utilities",
  "version": "0.1.0",
  "title": "Factory utilities",
  "description": "The reference factory: four production lines served by compressed air, chilled water and power, composed only from the built-in library, with the air and cooling loops closed by sampled ports.",
  "stresses": "coupled utility subsystems whose faults look alike across subsystems: air leaks against airend wear, tower fan failure against a heat wave, a stale main meter against its sub-meters",
  "axes": {"absence": "signal", "actuation": "advisory", "cadence": ["periodic"], "cardinality": "fleet", "consequence": ["cost", "downtime"],
    "correlation": ["coupled", "cascading"], "fidelity": ["F0", "F1"], "lateness": "none", "rate": "medium", "seasonality": ["diurnal", "weekly"],
    "time_reference": "wall", "value_shape": ["scalar"]},
  "site": {"name": "Factory", "timezone": "Europe/Berlin"},
  "areas": [{"name": "Site"}, {"name": "Production hall", "parent": "Site"}, {"name": "Compressor room", "parent": "Site"},
    {"name": "Chiller plant", "parent": "Site"}, {"name": "Substation", "parent": "Site"}],
  "equipment": [
    {"use": "streamsim/weather@1", "names": ["WX-1"], "area": "Site"},
    {"use": "streamsim/site-calendar@1", "names": ["CAL-1"], "area": "Site"},
    {"use": "streamsim/production-line@1", "as": "molder", "names": ["M-1", "M-2"], "area": "Production hall"},
    {"use": "streamsim/production-line@1", "as": "cnc", "preset": "small", "names": ["M-3"], "area": "Production hall"},
    {"use": "streamsim/packaging-line@1", "names": ["M-4"], "area": "Production hall"},
    {"use": "streamsim/ahu@1", "names": ["AHU-1"], "area": "Production hall"},
    {"use": "streamsim/air-compressor@1", "as": "compressor_lead", "parameters": {"load_kpa": 680, "unload_kpa": 730}, "names": ["AC-1"], "area": "Compressor room"},
    {"use": "streamsim/air-compressor@1", "as": "compressor_lag", "parameters": {"load_kpa": 650, "unload_kpa": 700}, "names": ["AC-2"], "area": "Compressor room"},
    {"use": "streamsim/air-receiver@1", "names": ["R-1"], "area": "Compressor room"},
    {"use": "streamsim/air-dryer@1", "names": ["D-1"], "area": "Compressor room"},
    {"use": "streamsim/chiller@1", "names": ["CH-1"], "area": "Chiller plant"},
    {"use": "streamsim/cooling-tower@1", "names": ["CT-1"], "area": "Chiller plant"},
    {"use": "streamsim/pump@1", "as": "chw_pump", "names": ["P-1", "P-2", "P-3"], "area": "Chiller plant"},
    {"use": "streamsim/pump@1", "as": "cw_pump", "names": ["P-4"], "area": "Chiller plant"},
    {"use": "streamsim/feeder-meter@1", "as": "air_meter", "preset": "small", "names": ["MB-AIR"], "area": "Substation"},
    {"use": "streamsim/feeder-meter@1", "as": "cooling_meter", "preset": "small", "names": ["MB-COOL"], "area": "Substation"},
    {"use": "streamsim/feeder-meter@1", "as": "process_meter", "names": ["MB-PROC"], "area": "Substation"},
    {"use": "streamsim/feeder-meter@1", "as": "main_meter", "names": ["MM-1"], "area": "Substation"},
    {"use": "streamsim/transformer@1", "preset": "large", "names": ["TX-1"], "area": "Substation"},
    {"use": "streamsim/generator@1", "names": ["G-1"], "area": "Substation"}
  ],
  "connections": [
    {"from": "CAL-1.shift_out", "to": "M-1.shift_in"}, {"from": "CAL-1.shift_out", "to": "M-2.shift_in"},
    {"from": "CAL-1.shift_out", "to": "M-3.shift_in"}, {"from": "CAL-1.shift_out", "to": "M-4.shift_in"},
    {"from": "CAL-1.shift_out", "to": "AHU-1.shift_in"}, {"from": "CAL-1.tariff_out", "to": "CH-1.tariff_in"},
    {"from": "WX-1.dry_bulb_out", "to": "AHU-1.outdoor_in"}, {"from": "WX-1.wet_bulb_out", "to": "CT-1.wet_bulb_in"},

    {"from": "AC-1.air_out", "to": "R-1.air_in"}, {"from": "AC-2.air_out", "to": "R-1.air_in"},
    {"from": "M-1.air_out", "to": "R-1.demand_in"}, {"from": "M-2.air_out", "to": "R-1.demand_in"},
    {"from": "M-3.air_out", "to": "R-1.demand_in"}, {"from": "M-4.air_out", "to": "R-1.demand_in"},
    {"from": "R-1.air_out", "to": "D-1.air_in"},
    {"from": "R-1.pressure_out", "to": "AC-1.pressure_in"}, {"from": "R-1.pressure_out", "to": "AC-2.pressure_in"},
    {"from": "R-1.pressure_out", "to": "M-1.air_in"}, {"from": "R-1.pressure_out", "to": "M-2.air_in"},
    {"from": "R-1.pressure_out", "to": "M-3.air_in"}, {"from": "R-1.pressure_out", "to": "M-4.air_in"},
    {"from": "D-1.dew_point_out", "to": "M-1.dew_point_in"}, {"from": "D-1.dew_point_out", "to": "M-2.dew_point_in"},
    {"from": "D-1.dew_point_out", "to": "M-3.dew_point_in"}, {"from": "D-1.dew_point_out", "to": "M-4.dew_point_in"},

    {"from": "M-1.heat_out", "to": "CH-1.load_in"}, {"from": "M-2.heat_out", "to": "CH-1.load_in"},
    {"from": "M-3.heat_out", "to": "CH-1.load_in"}, {"from": "M-4.heat_out", "to": "CH-1.load_in"},
    {"from": "AHU-1.load_out", "to": "CH-1.load_in"},
    {"from": "P-1.flow_out", "to": "CH-1.flow_in"}, {"from": "P-2.flow_out", "to": "CH-1.flow_in"}, {"from": "P-3.flow_out", "to": "CH-1.flow_in"},
    {"from": "CH-1.supply_out", "to": "M-1.coolant_in"}, {"from": "CH-1.supply_out", "to": "M-2.coolant_in"},
    {"from": "CH-1.supply_out", "to": "M-3.coolant_in"}, {"from": "CH-1.supply_out", "to": "M-4.coolant_in"},
    {"from": "CH-1.supply_out", "to": "AHU-1.chw_in"},
    {"from": "CH-1.heat_out", "to": "CT-1.heat_in"}, {"from": "P-4.cw_flow_out", "to": "CT-1.cw_flow_in"},
    {"from": "CT-1.basin_out", "to": "CH-1.cond_water_in"},

    {"from": "AC-1.power_out", "to": "MB-AIR.loads_in"}, {"from": "AC-2.power_out", "to": "MB-AIR.loads_in"},
    {"from": "D-1.power_out", "to": "MB-AIR.loads_in"},
    {"from": "M-1.power_out", "to": "MB-PROC.loads_in"}, {"from": "M-2.power_out", "to": "MB-PROC.loads_in"},
    {"from": "M-3.power_out", "to": "MB-PROC.loads_in"}, {"from": "M-4.power_out", "to": "MB-PROC.loads_in"},
    {"from": "CH-1.power_out", "to": "MB-COOL.loads_in"}, {"from": "CT-1.power_out", "to": "MB-COOL.loads_in"},
    {"from": "P-1.power_out", "to": "MB-COOL.loads_in"}, {"from": "P-2.power_out", "to": "MB-COOL.loads_in"},
    {"from": "P-3.power_out", "to": "MB-COOL.loads_in"}, {"from": "P-4.power_out", "to": "MB-COOL.loads_in"},
    {"from": "MB-AIR.power_out", "to": "MM-1.loads_in"}, {"from": "MB-COOL.power_out", "to": "MM-1.loads_in"},
    {"from": "MB-PROC.power_out", "to": "MM-1.loads_in"},
    {"from": "MM-1.power_out", "to": "TX-1.load_in"}, {"from": "MM-1.power_out", "to": "G-1.load_in"}
  ],
  "profiles": [
    {"name": "nominal", "duration_s": 86400, "description": "A production day of the factory, one fault per scenario."},
    {"name": "sensor_pathology", "duration_s": 86400, "description": "An instrument lies while the process is healthy."},
    {"name": "correlated_cascade", "duration_s": 86400, "description": "A utility fault spreads through the links: low header pressure slows every line, a weak tower warms the chilled water every line and the air handler draw on."}
  ],
  "ground_truth": {"min_per_label": 10, "min_scenarios": 100, "negative_class_fraction": 0.35, "pre_degraded_fraction": 0.0}
}
