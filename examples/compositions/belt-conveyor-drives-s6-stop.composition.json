{
  "schema_version": "0.1",
  "id": "belt-conveyor-drives-s6-stop",
  "version": "0.1.0",
  "title": "Belt conveyor with margin, D-1 speed master, followers stop on its loss",
  "description": "Plant a with the drives in a master-follower line (synthetic numbers): D-1 runs the speed loop and passes its reference to D-2, D-2 to D-3; the followers stop when they lose it, so the belt stops loaded.",
  "stresses": "load shared across drives on one belt: a failing drive moves load onto its peers, and a stop at the wrong moment strands a loaded belt",
  "axes": {"absence": "signal", "actuation": "interlocked", "cadence": ["periodic", "report_by_exception"], "cardinality": "small", "consequence": ["downtime", "safety"],
    "correlation": ["coupled", "cascading"], "fidelity": ["F0", "F1"], "lateness": "none", "rate": "medium", "seasonality": ["diurnal"],
    "time_reference": "wall", "value_shape": ["scalar", "boolean"]},
  "site": {"name": "Bulk terminal", "timezone": "Europe/Berlin"},
  "areas": [{"name": "Terminal"}, {"name": "Transfer belt", "parent": "Terminal"}, {"name": "Drive station", "parent": "Transfer belt"}],
  "equipment": [
    {"use": "streamsim/bulk-feeder@1", "names": ["F-1"], "area": "Transfer belt", "implements": "bulk_feeder", "board_type": "feeder-controller"},
    {"use": "streamsim/belt-conveyor@1", "parameters": {"breakaway_n_per_kg": 1.424}, "names": ["B-1"], "area": "Transfer belt", "implements": "belt_conveyor", "board_type": "belt-controller"},
    {"use": "streamsim/conveyor-drive@2", "as": "drive_master", "parameters": {"margin": "strong", "role": "master"}, "names": ["D-1"], "area": "Drive station", "implements": "drive_master", "board_type": "drive-master-controller",
      "expected_actions": {
        "lube_loss": [{"kind": "bulk_feeder", "effector": "set_feed"}, {"kind": "drive_master", "effector": "stop_drive"}],
        "gear_oil_loss": [{"kind": "bulk_feeder", "effector": "set_feed"}, {"kind": "drive_master", "effector": "stop_drive"}, {"kind": "belt_conveyor", "effector": "stop_belt"}],
        "vfd_fault": [{"kind": "bulk_feeder", "effector": "set_feed"}]
      }},
    {"use": "streamsim/conveyor-drive@2", "as": "drive_follower", "parameters": {"margin": "strong", "role": "follower", "master_loss": "stop_all"}, "names": ["D-2", "D-3"], "area": "Drive station", "implements": "drive_follower", "board_type": "drive-follower-controller",
      "expected_actions": {
        "lube_loss": [{"kind": "bulk_feeder", "effector": "set_feed"}, {"kind": "drive_follower", "effector": "stop_drive"}],
        "gear_oil_loss": [{"kind": "bulk_feeder", "effector": "set_feed"}, {"kind": "drive_follower", "effector": "stop_drive"}, {"kind": "belt_conveyor", "effector": "stop_belt"}],
        "vfd_fault": [{"kind": "bulk_feeder", "effector": "set_feed"}]
      }}
  ],
  "connections": [
    {"from": "F-1.feed_out", "to": "B-1.feed_in"},
    {"from": "B-1.moving_out", "to": "F-1.moving_in"},
    {"from": "B-1.share_out", "to": "D-1.share_in"}, {"from": "B-1.stop_ok_out", "to": "D-1.stop_ok_in"},
    {"from": "B-1.drives_out", "to": "D-1.drives_in"}, {"from": "B-1.weights_out", "to": "D-1.weights_in"}, {"from": "D-1.weighted_out", "to": "B-1.weights_in"},
    {"from": "D-1.enabled_out", "to": "B-1.drives_in"}, {"from": "D-1.drag_out", "to": "B-1.drag_in"}, {"from": "D-1.rated_out", "to": "B-1.rated_in"},
    {"from": "D-1.run_cap_out", "to": "B-1.run_cap_in"}, {"from": "D-1.boost_cap_out", "to": "B-1.boost_cap_in"}, {"from": "D-1.ready_cap_out", "to": "B-1.ready_cap_in"},
    {"from": "B-1.share_out", "to": "D-2.share_in"}, {"from": "B-1.stop_ok_out", "to": "D-2.stop_ok_in"},
    {"from": "B-1.drives_out", "to": "D-2.drives_in"}, {"from": "B-1.weights_out", "to": "D-2.weights_in"}, {"from": "D-2.weighted_out", "to": "B-1.weights_in"},
    {"from": "D-2.enabled_out", "to": "B-1.drives_in"}, {"from": "D-2.drag_out", "to": "B-1.drag_in"}, {"from": "D-2.rated_out", "to": "B-1.rated_in"},
    {"from": "D-2.run_cap_out", "to": "B-1.run_cap_in"}, {"from": "D-2.boost_cap_out", "to": "B-1.boost_cap_in"}, {"from": "D-2.ready_cap_out", "to": "B-1.ready_cap_in"},
    {"from": "B-1.share_out", "to": "D-3.share_in"}, {"from": "B-1.stop_ok_out", "to": "D-3.stop_ok_in"},
    {"from": "B-1.drives_out", "to": "D-3.drives_in"}, {"from": "B-1.weights_out", "to": "D-3.weights_in"}, {"from": "D-3.weighted_out", "to": "B-1.weights_in"},
    {"from": "D-3.enabled_out", "to": "B-1.drives_in"}, {"from": "D-3.drag_out", "to": "B-1.drag_in"}, {"from": "D-3.rated_out", "to": "B-1.rated_in"},
    {"from": "D-3.run_cap_out", "to": "B-1.run_cap_in"}, {"from": "D-3.boost_cap_out", "to": "B-1.boost_cap_in"}, {"from": "D-3.ready_cap_out", "to": "B-1.ready_cap_in"},
    {"from": "D-1.reference_out", "to": "D-2.reference_in"}, {"from": "D-2.reference_out", "to": "D-3.reference_in"}
  ],
  "profiles": [
    {"name": "nominal", "duration_s": 86400, "description": "A day of the belt at full feed, one fault per scenario."},
    {"name": "sensor_pathology", "duration_s": 86400, "fault_weights": {"drive_follower__vibration__frozen": 1.0, "drive_follower__winding__offset": 1.0, "belt_conveyor__tail_speed__offset": 1.0},
      "description": "An instrument lies while the belt and its drives are healthy: a frozen vibration reading, an offset winding or tail pulley reading."},
    {"name": "correlated_cascade", "duration_s": 86400, "fault_weights": {"drive_master__vfd_fault": 1.0, "drive_follower__gear_oil_loss": 1.0},
      "description": "The speed master's inverter trips; the followers stop when they lose it, so the belt stops loaded."}
  ],
  "ground_truth": {"min_per_label": 10, "min_scenarios": 100, "negative_class_fraction": 0.35, "pre_degraded_fraction": 0.0,
    "outcome_weights": {
      "boundaries": [{"kind": "belt_conveyor", "name": "stranded", "per_violation": 4}],
      "trips": [
        {"kind": "drive_master", "state": "relay_ok", "per_trip": 0.5}, {"kind": "drive_follower", "state": "relay_ok", "per_trip": 0.5}, {"kind": "drive_master", "state": "inverter_ok", "per_trip": 0.5}, {"kind": "drive_follower", "state": "inverter_ok", "per_trip": 0.5},
        {"kind": "drive_master", "state": "overtemp_ok", "per_trip": 0.5}, {"kind": "drive_follower", "state": "overtemp_ok", "per_trip": 0.5}, {"kind": "drive_master", "state": "free_ok", "per_trip": 0.5}, {"kind": "drive_follower", "state": "free_ok", "per_trip": 0.5},
        {"kind": "belt_conveyor", "state": "stall_ok", "per_trip": 0.5}
      ],
      "kpis": [
        {"kind": "drive_master", "state": "life_used", "per_unit": 0.0008}, {"kind": "drive_master", "state": "gear_used", "per_unit": 0.00032},
        {"kind": "drive_follower", "state": "life_used", "per_unit": 0.0008}, {"kind": "drive_follower", "state": "gear_used", "per_unit": 0.00032},
        {"kind": "belt_conveyor", "state": "delivered", "per_unit": -0.006666666666666667}
      ],
      "calls": [
        {"effector": "bulk_feeder__set_feed", "per_call": 0.25}, {"effector": "drive_master__stop_drive", "per_call": 0.25}, {"effector": "drive_follower__stop_drive", "per_call": 0.25},
        {"effector": "belt_conveyor__stop_belt", "per_call": 0.25}
      ],
      "tie": 0.1,
      "unit": "equivalent production hours"
    },
    "baseline_policies": [
      {"name": "b1", "label": "vibration alarm: feed 0, then stop the drive", "when": {"kind": "drive_follower", "state": "vibration", "operator": "gt", "threshold": 4.5}, "for_s": 60,
        "then": [{"effector": "bulk_feeder__set_feed", "target": "F-1", "args": {"percent": 0}},
          {"effector": "drive_follower__stop_drive", "target": "matched", "args": {"run_command": 0}, "delay_s": 60}]},
      {"name": "b2", "label": "current threshold: feed 67 %", "when": {"kind": "drive_follower", "state": "current", "operator": "gt", "threshold": 3.385}, "for_s": 60,
        "then": [{"effector": "bulk_feeder__set_feed", "target": "F-1", "args": {"percent": 67}}]},
      {"name": "b3", "label": "safe limp feed: 54 % from the start", "when": {"kind": "bulk_feeder", "state": "feed_set", "operator": "gte", "threshold": 0},
        "then": [{"effector": "bulk_feeder__set_feed", "target": "F-1", "args": {"percent": 54}}]},
      {"name": "b4", "label": "drive lost: feed 67 %", "when": {"kind": "drive_master", "state": "available", "operator": "lt", "threshold": 0.5},
        "then": [{"effector": "bulk_feeder__set_feed", "target": "F-1", "args": {"percent": 67}}]}
    ]
  }
}
