{
  "board_type": "arduino-thermal",
  "kinds": {
    "fan": {
      "commands": {
        "set_cooling": {
          "raw": "set_pwm_lease",
          "args": {"duty_permille": {"from": "level_percent", "scale": 10}},
          "lease": {"arg": "lease_ms", "ms": 5000}
        },
        "stop_fan": {"raw": "stop_fan"}
      },
      "metrics": {
        "level_percent": {"raw": "duty_permille", "scale": 10}
      }
    },
    "indicator": {
      "commands": {
        "show_state": {
          "raw": "set_led",
          "by": "state",
          "table": {
            "off": {"brightness_permille": 0, "pattern": "off"},
            "watch": {"brightness_permille": 500, "pattern": "slow_blink"},
            "alert": {"brightness_permille": 1000, "pattern": "solid"}
          }
        },
        "stop_led": {"raw": "stop_led"}
      },
      "metrics": {
        "state": {"raw": "pattern", "table": {"off": "off", "slow_blink": "watch", "solid": "alert"}}
      },
      "raw_enums": {"pattern": ["off", "slow_blink", "solid"]}
    }
  }
}
