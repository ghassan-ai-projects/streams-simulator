{
  "schema_version": "0.1",
  "id": "streamsim/mag-flow-meter",
  "version": 1,
  "title": "Electromagnetic flow meter",
  "description": "Full-bore magnetic flow meter on a water line; noisy at low flow, offset after a lost empty-pipe calibration, reads zero in an empty pipe.",
  "tag": "FT",
  "unit_family": "volumetric_flow",
  "unit": "m3/h",
  "channel": {
    "value_type": "number",
    "resolution": 0.1,
    "fidelity": "F1",
    "absence": "signal",
    "cadence": {
      "mode": "periodic",
      "period_s": 5
    },
    "noise": {
      "model": "gaussian",
      "sigma": 0.003
    },
    "availability": {
      "uptime": 0.999,
      "mttr_s": 600
    }
  },
  "faults": [
    {
      "id": "offset",
      "form": "offset",
      "magnitude": 0.04
    },
    {
      "id": "empty_pipe",
      "form": "stuck",
      "stuck_at": "low",
      "quality": "out_of_range"
    },
    {
      "id": "dropout",
      "form": "dropout"
    },
    {
      "id": "air_bubbles",
      "form": "noise",
      "factor": 15,
      "quality": "suspect"
    },
    {
      "id": "calibration",
      "form": "scale",
      "factor": 1.04
    }
  ],
  "scaling": "span"
}
