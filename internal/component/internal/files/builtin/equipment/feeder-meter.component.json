{
  "schema_version": "0.1",
  "id": "streamsim/feeder-meter",
  "version": 1,
  "title": "Feeder meter",
  "description": "A metered feeder: its power is the sum of the loads linked into it, with the billing demand over fifteen-minute blocks and a ratchet, a running energy register, line current and loading.",
  "class": "electrical/switchgear/feeder_meter",
  "tags": [
    "electrical",
    "metering",
    "feeder"
  ],
  "icon": "feeder-meter",
  "kind": {
    "state": [
      {
        "name": "power",
        "unit": "kW",
        "initial": 330.06396,
        "min": 0
      },
      {
        "name": "demand",
        "unit": "kW",
        "initial": 600,
        "min": 0
      },
      {
        "name": "energy",
        "unit": "kWh",
        "initial": 250000,
        "min": 0
      },
      {
        "name": "current",
        "unit": "A",
        "initial": 528.102335,
        "min": 0
      },
      {
        "name": "loading",
        "unit": "%",
        "initial": 41.257995,
        "min": 0
      }
    ],
    "dynamics": [
      {
        "target": "power",
        "tier": "F0",
        "f0": {
          "baseline": 480,
          "drift_per_hour": 0,
          "seasonality": [
            {
              "amplitude": 150,
              "period_s": 86400,
              "phase_rad": -1.6
            }
          ]
        }
      },
      {
        "target": "demand",
        "tier": "F1",
        "dt_ms": 60000,
        "f1": {
          "form": "peak",
          "block_s": 900,
          "period_s": 2592000,
          "ratchet": 0.8,
          "previous_peak": 640,
          "inputs": [
            {
              "state": "power",
              "coef": 1
            }
          ]
        }
      },
      {
        "target": "energy",
        "tier": "F1",
        "dt_ms": 10000,
        "f1": {
          "form": "integrator",
          "gain": 0.000277777778,
          "inputs": [
            {
              "state": "power",
              "coef": 1
            }
          ]
        }
      },
      {
        "target": "current",
        "tier": "F1",
        "f1": {
          "form": "sum",
          "inputs": [
            {
              "state": "power",
              "coef": 1.6
            }
          ]
        }
      },
      {
        "target": "loading",
        "tier": "F1",
        "f1": {
          "form": "sum",
          "inputs": [
            {
              "state": "power",
              "coef": 0.125
            }
          ]
        }
      }
    ],
    "faults": [
      {
        "id": "sustained_overload",
        "affects": [
          {
            "state": "power",
            "delta": 0.3,
            "multiplicative": true
          }
        ],
        "observability": {
          "detector": {
            "form": "single_channel_snr",
            "channel": "power"
          },
          "first_observable_snr": 3.0,
          "unavoidable_snr": 10.0
        },
        "onset": {
          "magnitude": 1.0,
          "rate_per_hour": 0.5,
          "shape": "ramp"
        }
      },
      {
        "id": "capacitor_bank_failure",
        "affects": [
          {
            "state": "current",
            "delta": 0.12,
            "multiplicative": true
          }
        ],
        "observability": {
          "detector": {
            "form": "single_channel_snr",
            "channel": "current"
          },
          "first_observable_snr": 3.0,
          "unavoidable_snr": 10.0
        },
        "onset": {
          "magnitude": 1.0,
          "shape": "step"
        }
      },
      {
        "id": "load_surge",
        "affects": [
          {
            "state": "power",
            "delta": 0.15,
            "multiplicative": true
          }
        ],
        "is_negative_class": true,
        "observability": {
          "detector": {
            "form": "single_channel_snr",
            "channel": "power"
          },
          "first_observable_snr": 3.0,
          "unavoidable_snr": 10.0
        },
        "onset": {
          "duty_cycle": 0.3,
          "magnitude": 1.0,
          "rate_per_hour": 2.0,
          "shape": "intermittent"
        }
      }
    ]
  },
  "measurement_points": [
    {
      "name": "power",
      "state": "power",
      "unit_family": "power",
      "range": {
        "min": 0,
        "max": 1000
      },
      "tag": "JT",
      "default_instrument": "streamsim/power-meter@1"
    },
    {
      "name": "demand",
      "state": "demand",
      "unit_family": "power",
      "range": {
        "min": 0,
        "max": 1000
      },
      "tag": "JT",
      "default_instrument": "streamsim/power-meter@1"
    },
    {
      "name": "energy",
      "state": "energy",
      "unit_family": "energy",
      "range": {
        "min": 0,
        "max": 10000000
      },
      "tag": "JT",
      "default_instrument": "streamsim/energy-meter@1"
    },
    {
      "name": "current",
      "state": "current",
      "unit_family": "current",
      "range": {
        "min": 0,
        "max": 2500
      },
      "tag": "IT",
      "default_instrument": "streamsim/current-clamp@1"
    }
  ],
  "ports": [
    {
      "name": "loads_in",
      "type": "electrical",
      "direction": "consumes",
      "state": "power"
    },
    {
      "name": "power_out",
      "type": "electrical",
      "direction": "provides",
      "state": "power"
    }
  ],
  "default_preset": "medium",
  "presets": {
    "small": {
      "title": "Small (about 250 kW feeder)",
