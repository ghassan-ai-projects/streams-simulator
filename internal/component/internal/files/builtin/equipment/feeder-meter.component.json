    },
    "large": {
      "title": "Large (about 2.5 MW feeder)",
      "values": {
        "state/power/initial": 1030.2004,
        "state/current/initial": 1648.3207,
        "state/loading/initial": 41.208,
        "state/demand/initial": 1875,
        "state/energy/initial": 900000,
        "dynamics/power/f0/baseline": 1500,
        "dynamics/power/f0/seasonality/0/amplitude": 470,
        "dynamics/demand/f1/previous_peak": 2000,
