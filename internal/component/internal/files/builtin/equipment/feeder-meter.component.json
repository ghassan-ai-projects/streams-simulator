        "measurement_points/power/range/max": 3125,
        "measurement_points/demand/range/max": 3125,
        "measurement_points/current/range/max": 8000
      }
    }
  },
  "parameters": [
    {
      "name": "ratchet",
      "title": "Demand ratchet",
      "unit": "ratio",
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.8,
      "targets": [
        "dynamics/demand/f1/ratchet"
      ]
    },
    {
      "name": "demand_block",
      "title": "Demand block",
      "type": "enum",
      "values": [
        "quarter_hour",
        "half_hour"
      ],
      "default": "quarter_hour",
      "cases": {
        "quarter_hour": {
          "dynamics/demand/f1/block_s": 900
        },
        "half_hour": {
          "dynamics/demand/f1/block_s": 1800
        }
      }
    }
  ]
}
