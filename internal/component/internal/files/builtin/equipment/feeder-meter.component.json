        "state/demand/initial": 187.5,
        "state/energy/initial": 80000,
        "dynamics/power/f0/baseline": 150,
        "dynamics/power/f0/seasonality/0/amplitude": 45,
        "dynamics/demand/f1/previous_peak": 190,
        "dynamics/loading/f1/inputs/power/coef": 0.4,
        "measurement_points/power/range/max": 312.5,
        "measurement_points/demand/range/max": 312.5,
        "measurement_points/current/range/max": 800
