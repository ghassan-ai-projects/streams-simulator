        "unit": "degC",
        "initial": 132.172
      },
      {
        "name": "low_pressure_alarm",
        "unit": "on",
        "initial": 0
      }
    ],
    "dynamics": [
      {
        "target": "steam_demand",
        "tier": "F0",
        "f0": {
          "baseline": 0.91,
          "drift_per_hour": 0,
          "seasonality": [
            {
              "amplitude": 0.21,
              "period_s": 86400,
              "phase_rad": -1.6
            }
          ]
        }
      },
      {
        "target": "flame_ok",
        "tier": "F1",
        "dt_ms": 1000,
        "f1": {
          "form": "trip",
          "when": {
            "state": "flame_signal",
            "operator": "lt",
            "threshold": 0.5
          },
          "for_s": 3,
          "tripped_value": 0,
          "latch": true,
          "reset_on": "reset_count"
        }
      },
      {
        "target": "burner_on",
        "tier": "F1",
        "f1": {
          "form": "product",
          "inputs": [
            {
              "state": "running",
              "coef": 1
            },
            {
              "state": "flame_ok",
              "coef": 1
            }
          ]
        }
      },
      {
        "target": "firing_rate",
        "tier": "F1",
        "dt_ms": 1000,
        "f1": {
          "form": "pid",
          "pid": {
            "pv": "steam_pressure",
            "sp": "pressure_setpoint",
            "kp": 1.7,
            "ki": 0.014,
            "kd": 0,
            "action": "reverse"
          },
          "clamp": {
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "target": "efficiency",
        "tier": "F1",
        "f1": {
          "form": "curve",
          "inputs": [
            {
              "state": "firing_rate",
              "coef": 1
            },
            {
              "state": "fouling",
              "coef": 1
            }
          ],
          "table": {
            "x": [
              10,
              30,
              60,
              100
            ],
            "y": [
              0,
              0.15,
              0.3
            ],
            "grid": [
              [
                80,
                77,
                74
              ],
              [
                86,
                83,
                80
              ],
              [
                88,
                85,
                82
              ],
              [
                86,
                83,
                80
              ]
            ]
          }
        }
      },
      {
        "target": "steam_generation",
        "tier": "F1",
        "f1": {
          "form": "product",
          "inputs": [
            {
              "state": "firing_rate",
              "coef": 0.014
            },
            {
              "state": "burner_on",
              "coef": 1
            },
            {
              "state": "efficiency",
              "coef": 0.0116279
            }
          ]
        }
      },
      {
        "target": "steam_pressure",
        "tier": "F1",
        "dt_ms": 1000,
        "f1": {
          "form": "store",
          "capacity": 1.4,
          "inputs": [
            {
              "state": "steam_generation",
              "coef": 1
            },
            {
              "state": "steam_demand",
              "coef": -1
            },
            {
              "state": "steam_loss",
              "coef": -1
            }
          ]
        }
      },
      {
        "target": "steam_flow",
        "tier": "F1",
        "f1": {
          "form": "sum",
          "inputs": [
            {
              "state": "steam_demand",
              "coef": 1
            }
          ]
        }
      },
      {
        "target": "fuel_flow",
        "tier": "F1",
        "f1": {
          "form": "product",
          "inputs": [
            {
              "state": "firing_rate",
              "coef": 3.8093
            },
            {
              "state": "burner_on",
              "coef": 1
            }
          ]
        }
      },
      {
        "target": "stack_temp",
        "tier": "F1",
        "dt_ms": 1000,
        "f1": {
          "form": "first_order_lag",
          "time_constant_s": 120,
          "gain": 1,
          "inputs": [
            {
              "state": "burner_on",
              "coef": 110
            },
            {
              "state": "firing_rate",
              "coef": 0.45
            },
            {
              "state": "fouling",
              "coef": 120
            }
          ]
        }
      },
      {
        "target": "low_pressure_alarm",
        "tier": "F1",
        "dt_ms": 1000,
        "f1": {
          "form": "alarm",
          "alarm": {
            "watch": "steam_pressure",
            "limit": 900,
            "direction": "low",
            "deadband": 20,
            "on_delay_s": 10,
            "off_delay_s": 20,
            "priority": "high",
            "acknowledge": "ack_count",
            "shelve": "alarm_shelved"
          }
        }
      }
    ],
    "faults": [
      {
        "id": "scaling",
        "affects": [
          {
            "state": "fouling",
            "delta": 0.3
          }
        ],
        "observability": {
          "detector": {
            "form": "single_channel_snr",
            "channel": "stack_temp"
          },
          "first_observable_snr": 3.0,
          "unavoidable_snr": 10.0
        },
        "onset": {
          "magnitude": 1.0,
          "shape": "ramp",
          "rate_per_hour": 0.01
        }
      },
      {
        "id": "flame_failure",
        "affects": [
          {
            "state": "flame_signal",
            "delta": -1
          }
        ],
        "observability": {
          "detector": {
            "form": "single_channel_snr",
            "channel": "steam_pressure"
          },
          "first_observable_snr": 3.0,
          "unavoidable_snr": 10.0
