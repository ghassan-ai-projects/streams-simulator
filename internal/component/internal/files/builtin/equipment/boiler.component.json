        },
        "effect": {
          "dead_time_s": 0,
          "time_constant_s": 0,
          "state_deltas": [
            {
              "state": "pressure_setpoint",
              "assign_from_arg": "pressure_kpa"
            }
          ]
        }
      },
      {
        "name": "acknowledge_reset",
        "risk_class": "low",
        "idempotency_window_s": 3600,
        "ack": {
          "failure_modes": [
            {
              "mode": "ok",
              "probability": 1.0
            }
          ],
          "latency_ms": {
            "mean": 300,
            "sigma": 50
          }
        },
        "args_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boiler_id"
          ],
          "properties": {
            "boiler_id": {
              "type": "string"
            }
          }
        },
        "effect": {
          "dead_time_s": 0,
          "time_constant_s": 0,
          "state_deltas": [
            {
              "state": "ack_count",
              "delta": 1
            },
