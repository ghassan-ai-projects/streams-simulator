{
  "schema_version": "0.1",
  "id": "streamsim/boiler",
  "version": 1,
  "title": "Gas-fired steam boiler",
  "description": "Steam boiler holding header pressure: a PI controller moves the firing rate to keep pressure at the setpoint against the demand. Scale on the heat-exchange surface lowers efficiency, so the controller burns more fuel and the stack runs hotter while pressure stays on target. A flame failure trips the burner until it is acknowledged and reset, and low pressure raises an ISA-18.2 alarm.",
  "class": "static/boiler/steam_boiler",
  "tags": [
    "heat",
    "utilities",
    "steam"
  ],
  "icon": "boiler",
