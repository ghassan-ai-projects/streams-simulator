        "onset": {
          "magnitude": 1.0,
          "shape": "pulse",
          "duration_s": 10
        }
      },
      {
        "id": "safety_valve_simmering",
        "affects": [
          {
            "state": "steam_loss",
            "delta": 0.07
          }
        ],
        "observability": {
          "detector": {
            "form": "single_channel_snr",
            "channel": "fuel_flow"
          },
          "first_observable_snr": 3.0,
          "unavoidable_snr": 10.0
        },
        "onset": {
          "magnitude": 1.0,
          "shape": "step"
        }
      },
      {
        "id": "steam_demand_surge",
        "affects": [
          {
            "state": "steam_demand",
            "delta": 0.3,
            "multiplicative": true
          }
        ],
        "is_negative_class": true,
        "observability": {
          "detector": {
            "form": "single_channel_snr",
            "channel": "steam_flow"
          },
          "first_observable_snr": 3.0,
          "unavoidable_snr": 10.0
        },
        "onset": {
          "magnitude": 1.0,
          "shape": "pulse",
          "duration_s": 1800
        }
      }
    ],
    "effectors": [
