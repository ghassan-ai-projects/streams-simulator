{
  "id": "structured-plant",
  "version": "0.1.0",
  "title": "Structured plant",
  "description": "A test domain with named instances, per-instance overrides, a system entity, typed links and boards.",
  "axes": {
    "absence": "signal",
    "actuation": "advisory",
    "cadence": ["periodic"],
    "cardinality": "fleet",
    "consequence": ["downtime"],
    "correlation": ["peer"],
    "fidelity": ["F0", "F1"],
    "lateness": "bounded",
    "rate": "low",
    "seasonality": ["none"],
    "time_reference": "wall",
    "value_shape": ["scalar"]
  },
  "stresses": "Instances of one kind differ: an override adds a state, a channel, a fault and an effector to one named tank and narrows bounds on one named pump, which a peer comparison and a fault must both respect.",
  "kinds": [
    {
      "name": "tank",
      "state": [
        {"name": "level_true", "unit": "m", "initial": 2.0},
        {"name": "inflow", "unit": "m3/h", "initial": 3.0}
      ],
      "dynamics": [
        {"target": "inflow", "tier": "F0", "f0": {"baseline": 3.0}},
        {
          "target": "level_true",
          "tier": "F1",
          "dt_ms": 1000,
          "f1": {
            "form": "first_order_lag",
            "gain": 1.0,
            "inputs": [{"state": "inflow", "coef": 1.0}],
            "time_constant_s": 600
          }
        }
      ],
      "channels": [
        {
          "name": "tank.level",
          "unit": "m",
          "absence": "signal",
          "cadence": {"mode": "periodic", "period_s": 60},
          "fidelity": "F1",
          "link_delay": {"mean_s": 0.1, "model": "constant"},
          "noise": {"model": "gaussian", "sigma": 0.05},
          "observes": "level_true",
          "resolution": 0.001,
          "value_type": "number"
        }
      ],
      "faults": [
        {
          "id": "tank_leak",
          "affects": [{"state": "level_true", "delta": -1.0}],
          "expected_effector": "refill",
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "tank.level"},
            "first_observable_snr": 3.2,
            "unavoidable_snr": 10.8
          },
          "onset": {"magnitude": 1.0, "rate_per_hour": 1.0, "shape": "ramp"}
        },
        {
          "id": "tank_nuisance",
          "affects": [{"state": "inflow", "delta": 0.5}],
          "is_negative_class": true,
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "tank.level"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"duty_cycle": 0.2, "magnitude": 0.5, "rate_per_hour": 1.0, "shape": "intermittent"}
        }
      ],
      "effectors": [
        {
          "name": "refill",
          "ack": {"failure_modes": [{"mode": "ok", "probability": 1.0}], "latency_ms": {"mean": 100, "sigma": 10}},
          "args_schema": {
            "additionalProperties": false,
            "properties": {"tank_id": {"type": "string"}},
            "required": ["tank_id"],
            "type": "object"
          },
          "confirmation_channels": ["tank.level"],
          "effect": {"dead_time_s": 0, "state_deltas": [{"state": "level_true", "delta": 0.5}], "time_constant_s": 120},
          "idempotency_window_s": 600,
          "risk_class": "low"
        }
      ]
    },
    {
      "name": "pump",
      "state": [
        {"name": "flow_true", "unit": "m3/h", "initial": 0.0},
        {"name": "demand", "unit": "rel", "initial": 4.0}
      ],
      "dynamics": [
        {"target": "demand", "tier": "F0", "f0": {"baseline": 4.0}},
        {
          "target": "flow_true",
          "tier": "F1",
          "dt_ms": 500,
          "f1": {
            "form": "first_order_lag",
            "gain": 0.5,
            "inputs": [{"state": "demand", "coef": 2.0}],
            "time_constant_s": 300
          }
        }
      ],
      "channels": [
        {
          "name": "pump.flow",
          "unit": "m3/h",
          "absence": "signal",
          "cadence": {"mode": "periodic", "period_s": 30},
          "fidelity": "F1",
          "link_delay": {"mean_s": 0.2, "model": "constant"},
          "noise": {"model": "gaussian", "sigma": 0.1},
          "observes": "flow_true",
          "range": {"min": 0, "max": 20},
          "resolution": 0.001,
          "value_type": "number"
        }
      ],
      "faults": [
        {
          "id": "pump_wear",
          "affects": [{"state": "flow_true", "delta": -2.0}],
          "expected_effector": "boost",
          "observability": {
            "detector": {"form": "peer_residual", "channel": "pump.flow"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "rate_per_hour": 2.0, "shape": "ramp"}
        },
        {
          "id": "pump_nuisance",
          "affects": [{"state": "demand", "delta": 1.0}],
          "is_negative_class": true,
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "pump.flow"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"duty_cycle": 0.2, "magnitude": 1.0, "rate_per_hour": 1.0, "shape": "intermittent"}
        }
      ],
      "effectors": [
        {
          "name": "boost",
          "ack": {"failure_modes": [{"mode": "ok", "probability": 1.0}], "latency_ms": {"mean": 100, "sigma": 10}},
          "args_schema": {
            "additionalProperties": false,
            "properties": {"pump_id": {"type": "string"}, "speed": {"maximum": 100, "minimum": 0, "type": "number"}},
            "required": ["pump_id"],
            "type": "object"
          },
          "confirmation_channels": ["pump.flow"],
          "effect": {"dead_time_s": 0, "state_deltas": [{"state": "demand", "delta": 1.0}], "time_constant_s": 60},
          "idempotency_window_s": 600,
          "risk_class": "low"
        }
      ]
    },
    {
      "name": "header",
      "system": true,
      "state": [{"name": "pressure", "unit": "bar", "initial": 7.0}],
      "dynamics": [{"target": "pressure", "tier": "F0", "f0": {"baseline": 7.0}}],
      "channels": [
        {
          "name": "header.pressure",
          "unit": "bar",
          "absence": "signal",
          "cadence": {"mode": "periodic", "period_s": 30},
          "fidelity": "F0",
          "link_delay": {"mean_s": 0.1, "model": "constant"},
          "noise": {"model": "gaussian", "sigma": 0.02},
          "observes": "pressure",
          "resolution": 0.001,
          "value_type": "number"
        }
      ],
      "faults": [
        {
          "id": "header_leak",
          "affects": [{"state": "pressure", "delta": -1.0}],
          "observability": {
            "detector": {"form": "single_channel_snr", "channel": "header.pressure"},
            "first_observable_snr": 3.0,
            "unavoidable_snr": 10.0
          },
          "onset": {"magnitude": 1.0, "rate_per_hour": 2.0, "shape": "ramp"}
        }
      ]
    }
  ],
  "instances": [
    {"kind": "tank", "id_template": "tank-{n}", "count": {"default": 2, "min": 1, "max": 6}},
    {
      "kind": "tank",
      "names": ["T-main"],
      "override": {
        "state": [{"name": "temp", "unit": "C", "initial": 20.0}],
        "dynamics": [
          {
            "target": "temp",
            "tier": "F1",
            "dt_ms": 1000,
            "f1": {
              "form": "first_order_lag",
              "gain": 1.0,
              "inputs": [{"state": "inflow", "coef": 2.0}],
              "time_constant_s": 900
            }
          }
        ],
        "channels": [
          {
            "name": "tank.temp",
            "unit": "C",
            "absence": "signal",
            "cadence": {"mode": "periodic", "period_s": 60},
            "fidelity": "F1",
            "link_delay": {"mean_s": 0.1, "model": "constant"},
            "noise": {"model": "gaussian", "sigma": 0.1},
            "observes": "temp",
            "resolution": 0.001,
            "value_type": "number"
          }
        ],
        "faults": [
          {
            "id": "tank_overheat",
            "affects": [{"state": "temp", "delta": 5.0}],
            "observability": {
              "detector": {"form": "single_channel_snr", "channel": "tank.temp"},
              "first_observable_snr": 3.0,
              "unavoidable_snr": 10.0
            },
            "onset": {"magnitude": 1.0, "rate_per_hour": 1.0, "shape": "ramp"}
          }
        ],
        "effectors": [
          {
            "name": "chill",
            "ack": {"failure_modes": [{"mode": "ok", "probability": 1.0}], "latency_ms": {"mean": 100, "sigma": 10}},
            "args_schema": {
              "additionalProperties": false,
              "properties": {"tank_id": {"type": "string"}},
              "required": ["tank_id"],
              "type": "object"
            },
            "confirmation_channels": ["tank.temp"],
            "effect": {"dead_time_s": 0, "state_deltas": [{"state": "temp", "delta": -5.0}], "time_constant_s": 120},
            "idempotency_window_s": 600,
            "risk_class": "low"
          }
        ],
        "narrow": {"state": [{"name": "level_true", "min": 0.5, "max": 4.0}]}
      }
    },
    {"kind": "pump", "id_template": "pump-{n}", "count": {"default": 3, "min": 1, "max": 6}},
    {
      "kind": "pump",
      "names": ["P-slow"],
      "override": {
        "narrow": {
          "channels": [{"name": "pump.flow", "range": {"min": 2, "max": 12}}],
          "effectors": [{"name": "boost", "args": {"speed": {"maximum": 50}}}]
        }
      }
    },
    {"kind": "header", "names": ["air_header"]}
  ],
  "link_types": [
    {"name": "feeds", "from": "tank", "to": "pump", "description": "A tank supplies a pump."},
    {"name": "monitors", "from": "header", "to": "tank"}
  ],
  "links": [
    {"from": "tank-1", "to": "pump-1", "type": "feeds"},
    {"from": "T-main", "to": "P-slow", "type": "feeds"},
    {"from": "air_header", "to": "T-main", "type": "monitors"}
  ],
  "boards": [
    {"name": "board-01", "members": ["T-main", "P-slow", "air_header"]},
    {"name": "board-02", "members": ["tank-1", "pump-1"]}
  ],
  "profiles": [
    {
      "name": "nominal",
      "duration_s": 7200,
      "description": "Two tanks, one named tank, three pumps, one named pump and the air header."
    },
    {
      "name": "correlated_cascade",
      "not_applicable": "The test plant has no shared upstream cause.",
      "description": "Not applicable to the test plant."
    },
    {
      "name": "sensor_pathology",
      "duration_s": 7200,
      "fault_weights": {"pump_wear": 0.5, "tank_leak": 0.5},
      "description": "Only the two loud faults."
    }
  ],
  "ground_truth": {"min_per_label": 10, "min_scenarios": 100, "negative_class_fraction": 0.4, "pre_degraded_fraction": 0.1}
}
