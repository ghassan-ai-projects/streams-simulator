          "confirmation_channels": ["air.pressure"],
          "effect": {"dead_time_s": 0, "state_deltas": [{"state": "orders", "delta": 1.0}], "time_constant_s": 0},
          "idempotency_window_s": 600,
          "responder": {
            "clear_fault": true,
            "delay_s": 900,
            "match_arg": "cause",
