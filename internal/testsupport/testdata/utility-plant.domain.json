      "effectors": [
        {
          "name": "set_pressure_band",
          "ack": {"failure_modes": [{"mode": "ok", "probability": 1.0}], "latency_ms": {"mean": 100, "sigma": 10}},
          "args_schema": {
            "additionalProperties": false,
            "properties": {"high": {"type": "number"}, "low": {"type": "number"}},
