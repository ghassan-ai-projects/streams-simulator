            "stage_up": {"state": "pressure", "operator": "lt", "threshold": 0.0, "threshold_state": "band_low"},
            "stages": 4
          }
        }
      ],
      "channels": [
        {
          "name": "air.pressure",
          "unit": "u",
          "absence": "signal",
          "cadence": {"mode": "periodic", "period_s": 60},
          "fidelity": "F1",
          "noise": {"model": "gaussian", "sigma": 0.02},
