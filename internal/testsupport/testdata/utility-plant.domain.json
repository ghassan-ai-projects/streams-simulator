            "time_constant_s": 0
          },
          "idempotency_window_s": 600,
          "risk_class": "medium"
        },
        {
          "name": "boost_air",
          "ack": {"failure_modes": [{"mode": "ok", "probability": 1.0}], "latency_ms": {"mean": 100, "sigma": 10}},
          "args_schema": {
            "additionalProperties": false,
            "properties": {"lease_s": {"type": "number", "exclusiveMinimum": 0}, "rate": {"type": "number"}},
            "required": ["rate", "lease_s"],
            "type": "object"
          },
          "confirmation_channels": ["air.pressure"],
          "effect": {
            "dead_time_s": 0,
            "state_deltas": [{"state": "boost", "assign_from_arg": "rate"}],
            "time_constant_s": 0
          },
          "idempotency_window_s": 600,
          "lease": {"arg": "lease_s", "fallback": "safe_off", "safe_deltas": [{"state": "boost", "delta": 0.0}]},
          "risk_class": "medium"
        },
        {
          "name": "work_order",
          "ack": {"failure_modes": [{"mode": "ok", "probability": 1.0}], "latency_ms": {"mean": 100, "sigma": 10}},
          "args_schema": {
            "additionalProperties": false,
            "properties": {"cause": {"type": "string"}},
