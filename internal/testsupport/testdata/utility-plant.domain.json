          "risk_class": "medium"
        },
        {
          "name": "release_chiller",
          "ack": {"failure_modes": [{"mode": "ok", "probability": 1.0}], "latency_ms": {"mean": 100, "sigma": 10}},
          "args_schema": {
            "additionalProperties": false,
            "properties": {"chiller_id": {"type": "string"}},
            "required": ["chiller_id"],
            "type": "object"
          },
          "confirmation_channels": ["chiller.running"],
          "effect": {"dead_time_s": 0, "state_deltas": [{"state": "isolated", "delta": -1.0}], "time_constant_s": 0},
          "idempotency_window_s": 600,
          "risk_class": "medium"
        }
      ],
      "boundaries": [
        {"name": "low_flow_trip", "state": "low_flow", "severity": "major"},
        {"name": "oil_hot", "state": "hot", "severity": "critical"}
      ]
    },
    {
      "name": "air",
      "state": [
        {"name": "demand", "unit": "m3/min", "initial": 6.0},
        {"name": "pressure", "unit": "bar", "initial": 7.0, "min": 0.0, "max": 12.0},
        {"name": "band_low", "unit": "bar", "initial": 6.5},
        {"name": "band_high", "unit": "bar", "initial": 7.5},
        {"name": "stages", "unit": "count", "initial": 2.0},
        {"name": "boost", "unit": "m3/min", "initial": 0.0},
        {"name": "orders", "unit": "count", "initial": 0.0},
        {"name": "inspected", "unit": "count", "initial": 0.0}
      ],
      "dynamics": [
        {"target": "demand", "tier": "F0", "f0": {"baseline": 6.0}},
        {
          "target": "pressure",
          "tier": "F1",
          "dt_ms": 1000,
          "f1": {
            "form": "store",
            "capacity": 600.0,
            "inputs": [
              {"state": "stages", "coef": 3.0},
              {"state": "boost", "coef": 1.0},
              {"state": "demand", "coef": -1.0}
