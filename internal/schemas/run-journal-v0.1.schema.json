{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streams-simulator.local/schemas/run-journal-v0.1.schema.json",
  "title": "Streams Simulator Run Journal v0.1",
  "description": "One line of a run journal: a JSON Lines record of the observer stream (journal.jsonl, readable by a consumer) or of the director stream (sealed/journal.jsonl, truth-bearing, director only). Both are written while the run happens and are pure functions of the run.",
  "type": "object",
  "required": ["stream", "seq", "type", "at_ns"],
  "properties": {
    "stream": {"enum": ["observer", "director"]},
    "seq": {"type": "integer", "minimum": 0, "description": "Numbers the replayable records of the stream from 0 without gaps. A session record (consumer.reported, pacing) carries the seq of the replayable record that follows it."},
    "type": {"enum": ["run.opened", "observation", "clock.advanced", "effector.acknowledged", "consumer.reported", "wire", "pacing", "origin", "binding", "live", "interrupt", "session", "command", "delivery", "state", "effector.outcome", "kpi.truth", "fault.truth", "run.unblinded", "run.closed"]},
    "at_ns": {"type": "integer", "description": "The world clock when the record was written; never a wall-clock read. A session record carries the time of the replayable record before it."}
  },
  "allOf": [
    {"if": {"properties": {"stream": {"const": "observer"}}}, "then": {"properties": {"type": {"enum": ["run.opened", "observation", "clock.advanced", "effector.acknowledged", "consumer.reported", "wire", "pacing", "origin", "binding", "live", "interrupt", "session", "run.closed"]}}}},
    {"if": {"properties": {"stream": {"const": "director"}}}, "then": {"properties": {"type": {"enum": ["run.opened", "command", "delivery", "state", "effector.outcome", "kpi.truth", "fault.truth", "run.unblinded", "run.closed", "wire", "pacing"]}}}},
    {"if": {"properties": {"stream": {"const": "observer"}, "type": {"const": "run.opened"}}}, "then": {"$ref": "#/$defs/run_opened"}},
    {"if": {"properties": {"stream": {"const": "director"}, "type": {"const": "run.opened"}}}, "then": {"$ref": "#/$defs/director_opened"}},
    {"if": {"properties": {"type": {"const": "observation"}}}, "then": {"$ref": "#/$defs/observation"}},
    {"if": {"properties": {"type": {"const": "clock.advanced"}}}, "then": {"$ref": "#/$defs/clock_advanced"}},
    {"if": {"properties": {"type": {"const": "effector.acknowledged"}}}, "then": {"$ref": "#/$defs/effector_acknowledged"}},
    {"if": {"properties": {"type": {"const": "consumer.reported"}}}, "then": {"$ref": "#/$defs/consumer_reported"}},
    {"if": {"properties": {"type": {"const": "wire"}}}, "then": {"$ref": "#/$defs/wire"}},
    {"if": {"properties": {"type": {"const": "pacing"}}}, "then": {"$ref": "#/$defs/pacing"}},
    {"if": {"properties": {"type": {"const": "origin"}}}, "then": {"$ref": "#/$defs/origin"}},
    {"if": {"properties": {"type": {"const": "binding"}}}, "then": {"$ref": "#/$defs/binding"}},
    {"if": {"properties": {"type": {"const": "session"}}}, "then": {"$ref": "#/$defs/session"}},
    {"if": {"properties": {"type": {"const": "live"}}}, "then": {"$ref": "#/$defs/live"}},
    {"if": {"properties": {"type": {"const": "interrupt"}}}, "then": {"$ref": "#/$defs/interrupt"}},
    {"if": {"properties": {"type": {"const": "command"}}}, "then": {"$ref": "#/$defs/command"}},
    {"if": {"properties": {"type": {"const": "delivery"}}}, "then": {"$ref": "#/$defs/delivery"}},
    {"if": {"properties": {"type": {"const": "state"}}}, "then": {"$ref": "#/$defs/state"}},
    {"if": {"properties": {"type": {"const": "effector.outcome"}}}, "then": {"$ref": "#/$defs/effector_outcome"}},
    {"if": {"properties": {"type": {"const": "kpi.truth"}}}, "then": {"$ref": "#/$defs/kpi_truth"}},
    {"if": {"properties": {"type": {"const": "fault.truth"}}}, "then": {"$ref": "#/$defs/fault_truth"}},
    {"if": {"properties": {"type": {"const": "run.unblinded"}}}, "then": {"$ref": "#/$defs/run_unblinded"}},
    {"if": {"properties": {"type": {"const": "run.closed"}}}, "then": {"$ref": "#/$defs/run_closed"}}
  ],
  "$defs": {
    "session": {
      "description": "Observer session metadata, persisted before wire traffic. Outside the replayable stream digest.",
      "required": ["mode", "plan"],
      "properties": {"mode": {"const": "connected"}, "plan": {"type": "object", "required": ["domain", "environment", "instances", "implements_checked", "policies"],
        "properties": {"domain": {"type": "string"}, "environment": {"enum": ["simulated", "mixed"]}, "instances": {"type": "array", "items": {"type": "object"}}, "implements_checked": {"type": "array", "items": {"type": "object"}},
          "policies": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "description": "The allow-list in effect, sorted: the policy digests the session's simulated devices accepted in a command. A recorded configuration, not a replay input."}}}}
    },
    "live": {
      "description": "Observer session projection computed by plantwire from admitted protocol evidence. Latest 128 commands; truncation explicit. Marks are deltas. Outside the replayable digest.",
      "required": ["host", "gateway", "devices", "commands", "marks", "commands_truncated"],
      "properties": {
        "host": {"enum": ["unknown", "online", "offline"]},
        "gateway": {"enum": ["not_applicable", "unknown", "online", "offline"]},
        "commands_truncated": {"type": "boolean"},
        "interrupts": {"type": "object", "required": ["holds", "approve", "pending", "devices"], "description": "Present from the first barrier or tick of a node that has a control socket: the interrupt state at the node (node-control-v0.1 $defs/state): holds with their latch, approval scopes, commands waiting for approval and every covered device."},
        "devices": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/live_device"}},
        "commands": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/live_command"}},
        "marks": {"type": "array", "maxItems": 256, "items": {"type": "object", "required": ["at_ns", "kind", "subject", "label", "entity"], "properties": {"at_ns": {"type": "integer"}, "kind": {"enum": ["command", "connection"]}, "subject": {"enum": ["host", "gateway", "device", "command"]}, "label": {"type": "string"}, "entity": {"type": "string"}}}}
      }
    },
    "interrupt": {
      "description": "Observer, session. One record of the node's interrupt log (interrupt-log-v0.1) as the node wrote it: an operator control, a node decision about a command or a control, a stop. node_ns is on the clock named by clock. Outside the stream digest; the same records are in interrupts.jsonl.",
      "required": ["event", "node_ns", "clock"],
      "properties": {"event": {"enum": ["inventory", "control", "command", "clock", "flush", "reply", "verdict", "resolve", "stop", "effect", "purge"]}, "node_ns": {"type": "integer", "minimum": 0}, "clock": {"enum": ["world", "wall"]}}
    },
    "live_device": {
      "type": "object", "required": ["device", "board", "instance", "environment", "boot_id", "health", "reboots", "readings"],
      "properties": {
        "device": {"type": "string"}, "board": {"type": "string"}, "instance": {"type": "string"},
        "environment": {"enum": ["simulated", "hardware", "unknown"]}, "boot_id": {"type": "string"},
        "health": {"enum": ["online", "offline", "simulated"]}, "reboots": {"type": "integer", "minimum": 0},
        "readings": {"type": "array", "maxItems": 512, "items": {"type": "object", "required": ["name", "unit", "value", "quality", "state"],
          "properties": {"name": {"type": "string"}, "unit": {"type": "string"}, "value": {"type": ["number", "boolean", "string", "null"]}, "quality": {"type": "string"}, "state": {"enum": ["good", "stale", "disconnected", "invalid", "untrusted", "simulated"]}}}}
      }
    },
    "live_command": {
      "type": "object", "required": ["command_id", "device", "environment", "command", "boot_id", "sent", "receipt", "reason", "report", "effect", "effect_evidence", "sent_at_ns", "updated_at_ns"],
      "properties": {
        "command_id": {"type": "string"}, "device": {"type": "string"}, "environment": {"enum": ["simulated", "hardware", "unknown"]}, "command": {"type": "string"}, "boot_id": {"type": "string"}, "sent": {"const": true},
        "receipt": {"enum": ["pending", "accepted", "refused"]}, "reason": {"type": "string"}, "report": {"enum": ["pending", "succeeded", "failed", "unknown"]},
        "effect": {"enum": ["unknown", "observed"]}, "effect_evidence": {"type": "string"}, "sent_at_ns": {"type": "integer"}, "updated_at_ns": {"type": "integer"},
        "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "The policy digest the host carried in the command. Present only when the receipt is refused with reason policy_not_allowed."}
      }
    },
    "ref": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "director_opened": {
      "description": "Director. The world's seed, which the observer stream never carries: with the seed and the domain a consumer could regenerate the fault-free world.",
      "required": ["run_id", "seed"],
      "properties": {"run_id": {"type": "string", "minLength": 1}, "seed": {"type": "integer", "minimum": 0}}
    },
    "run_opened": {
      "description": "Observer. The run's identity, written at creation. It has no seed (MCP_SURFACE section 4.5).",
      "required": ["run_id", "sim_version", "domain", "adapter", "start_time_ns", "entity_ids", "mode"],
      "not": {"required": ["seed"]},
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "sim_version": {"type": "string", "minLength": 1},
        "domain": {"$ref": "#/$defs/ref"},
        "adapter": {"$ref": "#/$defs/ref"},
        "start_time_ns": {"type": "integer"},
        "entity_ids": {"type": "array", "items": {"type": "string"}},
        "mode": {"enum": ["evaluate", "explore"], "description": "An explore run is unblinded from creation and never scored."}
      }
    },
    "observation": {
      "description": "Observer. A record exactly as the sink received it: the adapter's rendered line, with nothing of the native event the consumer was not given. malformed marks a line delivered broken; framing marks an adapter preamble or postamble line, which is in the trace but is no delivered event.",
      "required": ["line"],
      "properties": {"line": {"type": "string"}, "malformed": {"const": true}, "framing": {"enum": ["preamble", "postamble"]}}
    },
    "clock_advanced": {
      "description": "Observer. The world clock moved.",
      "required": ["to_ns"],
      "properties": {"to_ns": {"type": "integer"}}
    },
    "effector_acknowledged": {
      "description": "Observer. The acknowledgement an effector call returned to the operator, exactly as the operator received it. A declined call is not acknowledged and appears only in the director stream.",
      "required": ["command_id", "effector", "entity_id", "response"],
      "properties": {
        "command_id": {"type": "string"},
        "effector": {"type": "string"},
        "entity_id": {"type": "string"},
        "response": {
          "type": "object",
          "required": ["accepted", "simulated", "world_id", "command_id"],
          "properties": {
            "accepted": {"type": "boolean"},
            "simulated": {"type": "boolean"},
            "world_id": {"type": "string"},
            "command_id": {"type": "string"},
            "effect_eta_ns": {"type": "integer"},
            "reason": {"type": "string"}
          }
        }
      }
    },
    "consumer_reported": {
      "description": "Observer, session. A consumer report. Not in the command log, so outside the stream digest.",
      "required": ["quiesced_through_ns", "verdict_submitted"],
      "properties": {"quiesced_through_ns": {"type": "integer", "minimum": 0}, "verdict_submitted": {"type": "boolean"}}
    },
    "wire": {
      "description": "Observer, session. One plant wire record as the node sent (direction node) or received (direction host) it; in a relay session also as the relay received it from the gateway (direction gateway) or sent it to the gateway (direction relay). Outside the stream digest: the wire is reproduced by replaying the host's records.",
      "required": ["direction", "record"],
      "properties": {"direction": {"enum": ["node", "host", "gateway", "relay"]}, "record": {"type": "object"}}
    },
    "pacing": {
      "description": "Observer, session. One plant wire barrier: the NSYNC seq it covered, the wall time the node waited and whether the wall cap expired first.",
      "required": ["through_seq", "waited_ms", "missed"],
      "properties": {"through_seq": {"type": "integer", "minimum": 0}, "waited_ms": {"type": "integer", "minimum": 0}, "missed": {"type": "boolean"}}
    },
    "origin": {
      "description": "Observer, session. Where a device born to the host comes from, written each time its DBIRTH goes up in a connected session: the board that announced it, that board's environment (hardware: a real board behind the gateway; simulated: the world), its boot id, and the plant instance it is (absent for a gateway device the session plan does not bind). Outside the stream digest.",
      "required": ["device", "board", "environment", "boot_id"],
      "properties": {
        "instance": {"type": "string"},
        "device": {"type": "string"},
        "board": {"type": "string"},
        "environment": {"enum": ["simulated", "hardware"]},
        "boot_id": {"type": "string"}
      }
    },
    "binding": {
      "description": "Observer, session. The kind match of a session plan against what a gateway announced, written at each gateway handshake of a plan that binds an instance (and when a bound device is born as another kind): matched, or refused with the refusal the gateway was given, the rule in words and one issue per binding that does not hold, each pointing into the session plan. Outside the stream digest.",
      "required": ["outcome", "issues"],
      "properties": {
        "outcome": {"enum": ["matched", "refused"]},
        "refusal": {"type": "string"},
        "reason": {"type": "string"},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pointer", "message", "keyword"],
            "properties": {"pointer": {"type": "string"}, "message": {"type": "string"}, "keyword": {"type": "string"}, "member": {"type": "string"}}
          }
        }
      }
    },
    "command": {
      "description": "Director. A command-log entry.",
      "required": ["command"],
      "properties": {"command": {"type": "object", "required": ["seq", "at_ns", "op", "args"]}}
    },
    "delivery": {
      "description": "Director. A delivery-ledger row.",
      "required": ["delivery"],
      "properties": {"delivery": {"type": "object", "required": ["delivery_id", "seq", "delivered", "delivery_reason"]}}
    },
    "state": {
      "description": "Director. The world-state snapshot taken at an emission.",
      "required": ["state"],
      "properties": {"state": {"type": "object", "required": ["seq", "time_ns", "entity_id", "states"]}}
    },
    "kpi_truth": {
      "description": "Director. The run's KPI truth, written once before run.closed: the true mean, minimum and maximum of every KPI state and the ISA-18.2 KPIs of every alarm state, sampled on each kind's alarm scan step (domain-spec v0.2 section 29).",
      "required": ["kpis"],
      "properties": {"kpis": {"type": "object", "required": ["from_ns", "to_ns", "entities", "alarm_system"]}}
    },
    "fault_truth": {
      "description": "Director. Every fault of the run as an interval, written after each command that can change a fault and once more at the close (the last record is the run's fault truth): cleared_ns is the instant the world ends the fault, null while none is scheduled, and cleared_by names the clear command, the pulse's end or an effector responder.",
      "required": ["faults"],
      "properties": {
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fault_id", "entity_id", "fault", "injected_at_ns", "onset_ns", "cleared_ns", "cleared_by"],
            "properties": {
              "fault_id": {"type": "string"},
              "entity_id": {"type": "string"},
              "fault": {"type": "string"},
              "injected_at_ns": {"type": "integer"},
              "onset_ns": {"type": "integer"},
              "cleared_ns": {"type": ["integer", "null"]},
              "cleared_by": {"enum": ["command", "pulse_end", "responder", null]}
            }
          }
        }
      }
    },
    "effector_outcome": {
      "description": "Director. The world's record of an effector call: its result, or the refusal when it was declined.",
      "required": ["command_id", "effector", "entity_id"],
      "properties": {
        "command_id": {"type": "string"},
        "effector": {"type": "string"},
        "entity_id": {"type": "string"},
        "result": {"type": "object", "required": ["accepted", "simulated", "world_id", "command_id"]},
        "refused": {"type": "string", "minLength": 1}
      },
      "oneOf": [{"required": ["result"]}, {"required": ["refused"]}]
    },
    "run_unblinded": {
      "description": "Director. The run is unblinded: from creation in explore mode, at the close when the truth was revealed on an open run. The wall-clock moment is in the run artifact.",
      "required": ["reason"],
      "properties": {"reason": {"enum": ["explore", "revealed"]}}
    },
    "run_closed": {
      "description": "Both streams. The run ended. A journal that stops without it is an incomplete run, readable up to its last complete line.",
      "required": ["incomplete"],
      "properties": {"incomplete": {"type": "boolean"}, "error": {"type": "string"}}
    }
  }
}
