{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streams-simulator.local/schemas/domain-assumptions-v0.1.schema.json",
  "title": "Streams Simulator Domain Assumptions v0.1",
  "description": "The document `streamsim domain assumptions <domain-file>` prints: what a domain, or a twin scaffolded from kind files, declares about each reading and command (instrument, range, resolution, noise, cadence, response, gain, time constant), where each fact is recorded, and what the model does not reproduce. A pure function of its input files. It states conformance of declarations, never calibration or hardware validity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "origin", "kinds", "not_modeled"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["twin", "composition", "domain"], "description": "twin: the twin choices given reproduce this domain exactly; composition: the instances carry component provenance; domain: only what the domain file declares."},
        "twin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "status"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "status": {"enum": ["in_sync", "out_of_sync"], "description": "out_of_sync: the choices no longer produce this domain, so nothing is taken from them."}
          }
        }
      }
    },
    "kinds": {"type": "array", "items": {"$ref": "#/$defs/kind"}},
    "not_modeled": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "scope", "sentence"],
        "properties": {
          "code": {"enum": ["kind_file_members_not_reproduced", "first_order_response_only", "device_behavior_not_modeled", "safe_stop_is_a_step", "command_changes_nothing", "acknowledgement_never_fails", "saturation_not_declared", "no_measurement_noise", "instrument_semantics_unchecked", "no_calibration_evidence"]},
          "scope": {"type": "string", "minLength": 1, "description": "domain, a kind, or kind.name of a reading, dynamics target or command."},
          "sentence": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {"min": {"type": "number"}, "max": {"type": "number"}}
    },
    "recorded_in": {"enum": ["composition", "twin_choices", "domain_file"]},
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instances", "readings", "dynamics", "commands", "faults"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "implements": {"type": "string", "minLength": 1},
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "names": {"type": "array", "items": {"type": "string"}},
              "id_template": {"type": "string"},
              "count_default": {"type": "integer"},
              "area": {"type": "string"}
            }
          }
        },
        "readings": {"type": "array", "items": {"$ref": "#/$defs/reading"}},
        "dynamics": {"type": "array", "items": {"$ref": "#/$defs/dynamics"}},
        "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
        "faults": {"type": "array", "items": {"$ref": "#/$defs/fault"}}
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "value_type", "resolution", "noise", "cadence", "absence", "basis", "recorded_in"],
      "properties": {
        "channel": {"type": "string", "minLength": 1},
        "observes": {"type": "string"},
        "unit": {"type": "string"},
        "value_type": {"type": "string", "minLength": 1},
        "range": {"$ref": "#/$defs/range"},
        "resolution": {"type": "number"},
        "initial": {"type": "number", "description": "The true value the observed state starts at."},
        "noise": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "sigma"],
          "properties": {"model": {"type": "string"}, "sigma": {"type": "number"}}
        },
        "cadence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"type": "string"}, "period_s": {"type": "number"}, "deadband": {"type": "number"}}
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uptime", "mttr_s"],
          "properties": {"uptime": {"type": "number"}, "mttr_s": {"type": "number"}}
        },
        "absence": {"type": "string"},
        "tag": {"type": "string"},
        "basis": {"enum": ["library_instrument", "plain_channel", "domain_declared"]},
        "instrument": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "ref"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "integer", "minimum": 1},
            "ref": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "recorded_in": {"$ref": "#/$defs/recorded_in"},
        "equals_binary_suggestion": {"type": "boolean", "description": "The recorded instrument is the one `kind twin --suggest` proposes. Whether a person chose or accepted it is not recorded."}
      }
    },
    "dynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "tier", "inputs"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "tier": {"type": "string", "minLength": 1},
        "form": {"type": "string"},
        "gain": {"type": "number"},
        "time_constant_s": {"type": "number"},
        "dead_time_s": {"type": "number"},
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "coef"],
            "properties": {"state": {"type": "string"}, "coef": {"type": "number"}, "link": {"type": "string"}}
          }
        },
        "clamp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"min": {"type": "number"}, "max": {"type": "number"}}
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "safe_stop", "arguments", "response", "recorded_in", "sets", "drives", "effect", "acknowledgement", "statement"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "risk_class": {"type": "string"},
        "safe_stop": {"type": "boolean"},
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "minimum": {"type": "number"}, "maximum": {"type": "number"}}
          }
        },
        "response": {"enum": ["direct", "first_order", "none", "fixed_safe_stop", "declared"]},
        "recorded_in": {"$ref": "#/$defs/recorded_in"},
        "sets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["argument", "state"],
            "properties": {"argument": {"type": "string"}, "state": {"type": "string"}}
          }
        },
        "drives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "kind", "metric", "gain", "time_constant_s"],
            "properties": {"from": {"type": "string"}, "kind": {"type": "string"}, "metric": {"type": "string"}, "gain": {"type": "number"}, "time_constant_s": {"type": "number"}}
          }
        },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dead_time_s", "time_constant_s", "state_changes"],
          "properties": {"dead_time_s": {"type": "number"}, "time_constant_s": {"type": "number"}, "state_changes": {"type": "integer", "minimum": 0}}
        },
        "acknowledgement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latency_ms_mean", "latency_ms_sigma", "failure_modes"],
          "properties": {
            "latency_ms_mean": {"type": "number"},
            "latency_ms_sigma": {"type": "number"},
            "failure_modes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "probability"],
                "properties": {"mode": {"type": "string"}, "probability": {"type": "number"}}
              }
            }
          }
        },
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argument", "unit"],
          "properties": {"argument": {"type": "string"}, "unit": {"type": "string"}, "fallback": {"type": "string"}}
        },
        "equals_binary_suggestion": {"type": "boolean"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "negative_class", "onset_shape", "affects"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "negative_class": {"type": "boolean"},
        "onset_shape": {"type": "string"},
        "affects": {"type": "array", "items": {"type": "string"}},
        "on_reading": {"type": "string", "description": "The channel a reading fault corrupts; the world keeps its real value."}
      }
    }
  }
}
