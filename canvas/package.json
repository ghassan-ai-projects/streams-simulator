{
  "name": "streamsim-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "typecheck": "tsc --build --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "dup": "jscpd src",
    "knip": "knip",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run deps && npm run architecture && npm run dup && npm run knip && npm run test && npm run build && npm run css:emitted && npm run e2e",
    "preview": "vite preview",
    "architecture": "node scripts/check-architecture.ts && node scripts/check-css-architecture.ts && node scripts/check-ratchet.ts && node scripts/write-architecture-doc.ts --check && node scripts/sync-callers.ts --check",
    "css:emitted": "node scripts/check-emitted-css.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.3.3",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
