{
  "schema_version": "0.1",
  "id": "campus-3",
  "version": "0.1.0",
  "title": "Campus of 3 halls",
  "description": "Three production halls sharing the factory utilities, for the canvas end-to-end tests.",
  "stresses": "coupled utility subsystems whose faults look alike across subsystems: air leaks against airend wear, tower fan failure against a heat wave, a stale main meter against its sub-meters",
  "axes": {
    "absence": "signal",
    "actuation": "advisory",
    "cadence": ["periodic"],
    "cardinality": "fleet",
    "consequence": ["cost", "downtime"],
    "correlation": ["coupled", "cascading"],
    "fidelity": ["F0", "F1"],
    "lateness": "none",
    "rate": "medium",
    "seasonality": ["diurnal", "weekly"],
    "time_reference": "wall",
    "value_shape": ["scalar"]
  },
  "site": {
    "name": "Factory",
    "timezone": "Europe/Berlin"
  },
