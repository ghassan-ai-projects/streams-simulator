    "defaultCap": 300,
    "caps": {
      "src/ui/launch/internal/LaunchPanel.module.css": {
        "cap": 229,
        "phase": "P5"
      }
    },
    "globalCaps": {
      "src/ui/graph/internal/vendor.module.css": {
        "global": 6,
        "important": 0,
        "phase": "P1"
      },
      "src/ui/primitives/internal/shared.module.css": {
        "global": 3,
        "important": 0,
        "phase": "P5"
      },
      "src/ui/review/internal/ReviewScreen.module.css": {
        "global": 2,
        "important": 0,
        "phase": "P5"
      }
    },
    "colorExceptions": {
      "src/ui/primitives/internal/shared.module.css": {
        "literals": 2,
        "reason": "a mask gradient uses black as an alpha mask, not a semantic colour",
        "phase": "P5"
      }
    }
  },
  "floors": {
    "src/model/**": {
      "lines": 90,
      "functions": 90,
      "branches": 85,
      "statements": 90
    },
    "src/app/**": {
      "lines": 80,
      "functions": 80,
      "branches": 75,
      "statements": 80
    },
    "src/adapters/**": {
      "lines": 99,
      "functions": 99,
      "branches": 97,
      "statements": 99
    },
    "src/ui/**": {
      "lines": 96,
      "functions": 95,
      "branches": 89,
      "statements": 96
    }
  },
  "rules": {
    "actionNames": [
      "clock.advance",
      "component.example",
      "component.examples",
      "component.list",
      "component.new",
      "component.show",
      "component.validate",
      "domain.compose",
      "domain.lint",
      "domain.validate",
      "effector.invoke",
      "fault.inject",
      "kind.capture",
      "kind.check",
      "kind.suggest",
      "kind.twin",
      "kind.validate",
      "run.end",
      "run.report",
      "run.verify",
      "scenario.export",
      "session.check",
      "session.control",
      "session.start",
      "session.status",
      "session.stop",
      "world.create",
      "world.destroy"
    ],
    "protocolOwner": "adapters",
    "protocolProductionOnly": true,
    "restrictedAppImports": ["react", "react-dom", "react/jsx-runtime", "@xyflow/react", "lucide-react"],
    "restrictedAppGlobals": ["window", "document", "localStorage", "EventSource", "fetch", "globalThis"],
    "clockGlobals": [
      "setTimeout",
      "setInterval",
      "clearTimeout",
      "clearInterval",
      "requestAnimationFrame",
      "performance",
      "Date"
    ],
    "restrictedUiImports": ["/api/"],
    "booleanFactNames": ["empty", "explore", "playing", "systemPrefersDark"],
    "fakeTimerTests": [],
    "depcruiseRules": [
      {
        "name": "model-is-pure",
        "severity": "error"
      },
      {
        "name": "model-imports-nothing",
        "severity": "error"
      },
      {
        "name": "app-below-adapters-and-ui",
        "severity": "error"
      },
      {
        "name": "adapters-below-ui",
        "severity": "error"
      },
      {
        "name": "ui-never-touches-transport",
        "severity": "error"
      },
      {
        "name": "no-circular",
        "severity": "error"
      },
      {
        "name": "no-test-support-in-production",
        "severity": "error"
      },
      {
        "name": "no-orphans",
        "severity": "error"
      }
    ],
    "booleanFactNamePolicy": "a boolean parameter is allowed only when its name states one local fact; a name that selects an operating mode is a violation"
  },
  "emittedCss": {
    "order": [
      {
        "name": "vendor-react-flow",
        "selector": ".react-flow__handle{"
      },
      {
        "name": "graph",
        "selector": "tierCompact"
      },
      {
        "name": "theme-tokens",
        "selector": "--surface-panel:"
      },
      {
        "name": "theme-families",
        "selector": ".family-air{"
      }
    ],
    "important": 0,
    "zIndex": 15,
    "positioned": 29,
    "note": "Built counts: important 0 because the React Flow minimap panel overrides in vendor.module.css no longer need !important; z-index 15 and positioned 29 are the measured counts of the built sheet; the review notices live in the graph bar row, so none is positioned over the canvas."
  },
  "debt": [],
  "testSupport": ["test"]
}
