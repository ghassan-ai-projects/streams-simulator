{
  "version": 1,
  "source": "src",
  "modules": {
    "model": {
      "kind": "model",
      "layer": "model",
      "lifetime": "values",
      "responsibility": "immutable product values, pure transformations and parsing of canvas-owned documents",
      "folders": [
        "src/model"
      ],
      "mayImport": [
        "model/graph",
        "model/workspace"
      ],
      "entrypoint": null,
      "callers": [
        "adapters",
        "app",
        "app/ports",
        "model/graph",
        "test",
        "ui",
        "ui/graph"
      ]
    },
    "model/graph": {
      "kind": "model",
      "layer": "model",
      "lifetime": "values",
      "responsibility": "plant-view projection, graph geometry, wire routing and graph presentation values",
      "folders": [
        "src/model/graph"
      ],
      "mayImport": [
        "model"
      ],
      "entrypoint": "src/model/graph/index.ts",
      "callers": [
        "model",
        "test",
        "ui",
        "ui/graph"
      ]
    },
    "model/workspace": {
      "kind": "model",
      "layer": "model",
      "lifetime": "values",
      "responsibility": "workspace catalogue records and run listing projections",
      "folders": [
        "src/model/workspace"
      ],
      "mayImport": [
        "model/shared",
        "test"
      ],
      "entrypoint": "src/model/workspace/index.ts",
      "callers": [
        "adapters",
        "app",
        "app/ports",
        "model",
        "test",
        "ui"
      ]
    },
    "app": {
      "kind": "application",
      "layer": "app",
      "lifetime": "singleton",
      "responsibility": "use cases, state machines and the ports the outside must implement",
      "folders": [
        "src/app"
      ],
      "mayImport": [
        "app/ports",
        "app/session",
        "app/shared",
        "model",
        "model/workspace",
        "test"
      ],
      "entrypoint": null,
      "callers": [
        "root",
        "test",
        "ui"
      ]
    },
    "app/shared": {
      "kind": "foundation",
      "layer": "app",
      "lifetime": "singleton",
      "responsibility": "observable state and operation identity primitives shared by application modules",
      "folders": [
        "src/app/shared"
      ],
      "files": [
        "src/app/observable.ts"
      ],
      "mayImport": [],
      "entrypoint": "src/app/shared/index.ts",
      "callers": [
        "app",
        "app/session"
      ]
    },
    "app/ports": {
      "kind": "foundation",
      "layer": "app",
      "lifetime": "singleton",
      "responsibility": "dependency interfaces and time/browser ports required by application modules",
      "folders": [
        "src/app/ports"
      ],
      "files": [
        "src/app/ports.ts"
      ],
      "mayImport": [
        "model",
        "model/workspace"
      ],
      "entrypoint": "src/app/ports/index.ts",
      "callers": [
        "adapters",
        "app",
        "app/session",
        "test",
        "ui"
      ]
    },
    "app/session": {
      "kind": "application",
      "layer": "app",
      "lifetime": "singleton",
      "responsibility": "bridge pairing state and recovery",
      "folders": [
        "src/app/session"
      ],
      "mayImport": [
        "app/ports",
        "app/shared"
      ],
      "entrypoint": "src/app/session/index.ts",
      "callers": [
        "root",
        "ui"
      ]
    },
    "adapters": {
      "kind": "adapter",
      "layer": "adapters",
      "lifetime": "singleton",
      "responsibility": "bridge and browser edges: transport, protocol encoding and boundary decoding",
      "folders": [
        "src/adapters"
      ],
      "mayImport": [
        "app",
        "app/ports",
        "model",
        "model/workspace",
        "test"
      ],
      "entrypoint": null,
      "callers": [
        "root"
      ]
    },
    "ui": {
      "kind": "ui",
      "layer": "ui",
      "lifetime": "components",
      "responsibility": "rendering, input binding and component-local ephemeral state",
      "folders": [
        "src/ui"
      ],
      "mayImport": [
        "app",
        "app/ports",
        "app/session",
        "model",
        "model/graph",
        "model/workspace",
        "test",
        "ui/graph",
        "ui/primitives",
        "ui/session"
      ],
      "entrypoint": null,
      "callers": [
        "root",
        "test",
        "ui/graph"
      ]
    },
    "ui/primitives": {
      "kind": "ui",
      "layer": "ui",
      "lifetime": "components",
      "responsibility": "generic state subscription hook and visually stable shared building blocks",
      "folders": [
        "src/ui/primitives"
      ],
      "files": [
        "src/ui/useStore.ts"
      ],
      "mayImport": [],
      "entrypoint": "src/ui/primitives/index.ts",
      "callers": [
        "test",
        "ui"
      ]
    },
    "ui/session": {
      "kind": "ui",
      "layer": "ui",
      "lifetime": "components",
      "responsibility": "pairing screen and its presentation",
      "folders": [
        "src/ui/session"
      ],
      "mayImport": [
        "app/session",
        "ui/primitives"
      ],
      "entrypoint": "src/ui/session/index.ts",
      "callers": []
    },
    "ui/graph": {
      "kind": "ui",
      "layer": "ui",
      "lifetime": "components",
      "responsibility": "the streamsim plant graph: nodes, edges, controls, outline and viewport",
      "folders": [
        "src/ui/graph"
      ],
      "mayImport": [
        "ui",
        "model",
        "model/graph"
      ],
      "entrypoint": "src/ui/graph/index.ts",
      "callers": [
        "ui"
      ]
    },
    "test": {
      "kind": "test-support",
      "layer": "test",
      "lifetime": "per-test",
      "responsibility": "shared test drivers, fixtures and harnesses",
      "folders": [
        "src/test"
      ],
      "mayImportAny": true,
      "entrypoint": null,
      "callers": [
        "adapters",
        "app",
        "app/session",
        "model",
        "model/graph",
        "model/workspace",
        "ui",
        "ui/graph"
      ]
    },
    "root": {
      "kind": "composition",
      "layer": "root",
      "lifetime": "singleton",
      "responsibility": "the composition root: construct adapters and application objects and render the shell",
      "files": [
        "src/main.tsx"
      ],
      "mayImport": [
        "adapters",
        "app",
        "app/session",
        "ui",
        "model"
      ],
      "entrypoint": "src/main.tsx",
      "callers": []
    }
  },
  "targetModules": {
    "model/shared": {
      "kind": "model",
      "mayImport": [],
      "responsibility": "values two or more model modules need and none owns"
    },
    "model/shell": {
      "kind": "model",
      "mayImport": [
        "model/shared"
      ],
      "responsibility": "routes, navigation and theme values"
    },
    "model/workspace": {
      "kind": "model",
      "mayImport": [
        "model/shared"
      ],
      "responsibility": "workspace catalogue and run listing values"
    },
    "model/plant": {
      "kind": "model",
      "mayImport": [
        "model/shared"
      ],
      "responsibility": "plant values and component specifications"
    },
    "model/graph": {
      "kind": "model",
      "mayImport": [
        "model/shared",
        "model/plant"
      ],
      "responsibility": "plant-view projection, geometry, routing and presentation values"
    },
    "model/editor": {
      "kind": "model",
      "mayImport": [
        "model/shared",
        "model/plant",
        "model/graph"
      ],
      "responsibility": "composition document, edits and history values"
    },
    "model/launch": {
      "kind": "model",
      "mayImport": [
        "model/shared",
        "model/plant"
      ],
      "responsibility": "launch plans, steps, effectors and call outcomes"
    },
    "model/review": {
      "kind": "model",
      "mayImport": [
        "model/shared",
        "model/workspace",
        "model/plant",
        "model/graph"
      ],
      "responsibility": "report and journal projection, playback and review presentation"
    },
    "app/shared": {
      "kind": "application",
      "mayImport": [],
      "responsibility": "operation identity and application-wide foundations"
    },
    "app/ports": {
      "kind": "foundation",
      "mayImport": [
        "model/shared",
        "model/workspace",
        "model/plant",
        "model/editor",
        "model/launch",
        "model/review"
      ],
      "responsibility": "dependency interfaces only; no workflow"
    },
    "app/session": {
      "kind": "application",
      "mayImport": [
        "app/shared",
        "app/ports"
      ],
      "responsibility": "bridge pairing state and recovery"
    },
    "app/workspace": {
      "kind": "application",
      "mayImport": [
        "app/shared",
        "app/ports",
        "model/workspace"
      ],
      "responsibility": "workspace catalogue, reload lifecycle and home projections"
    },
    "app/plant": {
      "kind": "application",
      "mayImport": [
        "app/shared",
        "app/ports",
        "model/plant"
      ],
      "responsibility": "one plant projection, component specifications and selection"
    },
    "app/editor": {
      "kind": "application",
      "mayImport": [
        "app/shared",
        "app/ports",
        "model/editor",
        "model/plant",
        "model/graph"
      ],
      "responsibility": "composition draft, history, edits and the save transaction"
    },
    "app/launch": {
      "kind": "application",
      "mayImport": [
        "app/shared",
        "app/ports",
        "model/launch",
        "model/plant"
      ],
      "responsibility": "plan validation and execution, progress, early stop and rerun proposal"
    },
    "app/review": {
      "kind": "application",
      "mayImport": [
        "app/shared",
        "app/ports",
        "app/plant",
        "model/review",
        "model/workspace",
        "model/plant",
        "model/graph"
      ],
      "responsibility": "report and verification loading, observer playback and review selection"
    },
    "app/shell": {
      "kind": "application",
      "mayImport": [
        "app/shared",
        "app/ports",
        "app/session",
        "app/workspace",
        "app/plant",
        "app/editor",
        "app/launch",
        "app/review",
        "model/shell"
      ],
      "responsibility": "navigation, theme, panels, session gating, module composition and cross-module coordinators"
    },
    "adapters/browser": {
      "kind": "adapter",
      "mayImport": [
        "app/ports",
        "model/shell"
      ],
      "responsibility": "browser edges: location, preferences, system theme, clock and scheduler"
    },
    "adapters/bridge": {
      "kind": "adapter",
      "mayImport": [
        "app/ports",
        "model/shared",
        "model/workspace",
        "model/plant",
        "model/editor",
        "model/launch",
        "model/review"
      ],
      "responsibility": "the bridge: request encoding, response decoding and the run stream"
    },
    "ui/primitives": {
      "kind": "ui",
      "mayImport": [],
      "responsibility": "visually and semantically stable building blocks"
    },
    "ui/session": {
      "kind": "ui",
      "mayImport": [
        "ui/primitives",
        "app/session"
      ],
      "responsibility": "pairing screen"
    },
    "ui/workspace": {
      "kind": "ui",
      "mayImport": [
        "ui/primitives",
        "app/workspace"
      ],
      "responsibility": "workspace catalogue screen"
    },
    "ui/plant": {
      "kind": "ui",
      "mayImport": [
        "ui/primitives",
        "ui/graph",
        "ui/launch",
        "app/plant",
        "app/launch"
      ],
      "responsibility": "plant viewing screen, inspector and outline"
    },
    "ui/graph": {
      "kind": "ui",
      "mayImport": [
        "ui/primitives",
        "model/graph"
      ],
      "responsibility": "the streamsim plant graph: nodes, edges, controls and viewport"
    },
    "ui/editor": {
      "kind": "ui",
      "mayImport": [
        "ui/primitives",
        "ui/graph",
        "app/editor"
      ],
      "responsibility": "composition editor screen and panels"
    },
    "ui/launch": {
      "kind": "ui",
      "mayImport": [
        "ui/primitives",
        "app/launch"
      ],
      "responsibility": "launch panel and progress"
    },
    "ui/review": {
      "kind": "ui",
      "mayImport": [
        "ui/primitives",
        "ui/graph",
        "ui/launch",
        "app/review",
        "app/launch"
      ],
      "responsibility": "run review screen, report and playback"
    },
    "ui/shell": {
      "kind": "ui",
      "mayImport": [
        "ui/primitives",
        "ui/session",
        "ui/workspace",
        "ui/plant",
        "ui/editor",
        "ui/review",
        "app/shell"
      ],
      "responsibility": "application chrome, panels and routing"
    },
    "test": {
      "kind": "test-support",
      "mayImport": [],
      "responsibility": "shared test drivers, fixtures and harnesses"
    },
    "root": {
      "kind": "composition",
      "mayImport": [
        "adapters",
        "app",
        "ui",
        "model",
        "test"
      ],
      "responsibility": "the composition root"
    }
  },
  "targets": {
    "src/model/areaTree.test.ts": "model/shared",
    "src/model/areaTree.ts": "model/shared",
    "src/model/bridge.test.ts": "model/shared",
    "src/model/bridge.ts": "model/shared",
    "src/model/composition.test.ts": "model/editor",
    "src/model/composition.ts": "model/editor",
    "src/model/compositionEdits.test.ts": "model/editor",
    "src/model/compositionEdits.ts": "model/editor",
    "src/model/compositionKinds.test.ts": "model/editor",
    "src/model/effectors.test.ts": "model/launch",
    "src/model/effectors.ts": "model/launch",
    "src/model/instanceNameRule.test.ts": "model/editor",
    "src/model/instanceNameRule.ts": "model/editor",
    "src/model/kindNames.ts": "model/shared",
    "src/model/launch.test.ts": "model/launch",
    "src/model/launch.ts": "model/launch",
    "src/model/library.ts": "model/plant",
    "src/model/noteLines.test.ts": "model/review",
    "src/model/noteLines.ts": "model/review",
    "src/model/plant.test.ts": "model/plant",
    "src/model/plant.ts": "model/plant",
    "src/model/playback.test.ts": "model/review",
    "src/model/playback.ts": "model/review",
    "src/model/ports.test.ts": "model/plant",
    "src/model/ports.ts": "model/plant",
    "src/model/report.test.ts": "model/review",
    "src/model/report.ts": "model/review",
    "src/model/reportAlarms.test.ts": "model/review",
    "src/model/reportAlarms.ts": "model/review",
    "src/model/reportViews.test.ts": "model/review",
    "src/model/reportViews.ts": "model/review",
    "src/model/reviewAnchor.test.ts": "model/review",
    "src/model/reviewAnchor.ts": "model/review",
    "src/model/reviewRows.test.ts": "model/review",
    "src/model/reviewRows.ts": "model/review",
    "src/model/route.test.ts": "model/shell",
    "src/model/route.ts": "model/shell",
    "src/model/shared/words.ts": "model/shared",
    "src/model/theme.test.ts": "model/shell",
    "src/model/theme.ts": "model/shell",
    "src/model/timeline.test.ts": "model/review",
    "src/model/timeline.ts": "model/review",
    "src/model/units.test.ts": "model/shared",
    "src/model/units.ts": "model/shared",
    "src/model/workspace": "model/workspace",
    "src/app/shared": "app/shared",
    "src/app/session": "app/session",
    "src/app/workspaceStore.ts": "app/workspace",
    "src/app/workspaceStore.test.ts": "app/workspace",
    "src/app/plantStore.ts": "app/plant",
    "src/app/plantStore.test.ts": "app/plant",
    "src/app/plantMaker.ts": "app/plant",
    "src/app/plantMaker.test.ts": "app/plant",
    "src/app/componentSpecs.ts": "app/plant",
    "src/app/editorStore.ts": "app/editor",
    "src/app/editorStore.test.ts": "app/editor",
    "src/app/launchStore.ts": "app/launch",
    "src/app/launchStore.test.ts": "app/launch",
    "src/app/reviewStore.ts": "app/review",
    "src/app/reviewStore.test.ts": "app/review",
    "src/app/reviewCompletion.test.ts": "app/review",
    "src/app/reviewDomain.ts": "app/review",
    "src/app/navigationStore.ts": "app/shell",
    "src/app/navigationStore.test.ts": "app/shell",
    "src/app/panelStore.ts": "app/shell",
    "src/app/panelStore.test.ts": "app/shell",
    "src/app/themeStore.ts": "app/shell",
    "src/app/themeStore.test.ts": "app/shell",
    "src/app/observable.ts": "app/shared",
    "src/app/ports.ts": "app/ports",
    "src/app/ports": "app/ports",
    "src/adapters/bridgeClient.test.ts": "adapters/bridge",
    "src/adapters/bridge": "adapters/bridge",
    "src/adapters/browser": "adapters/browser",
    "src/adapters/browser.test.ts": "adapters/browser",
    "src/ui/home": "ui/workspace",
    "src/ui/primitives": "ui/primitives",
    "src/ui/plant": "ui/plant",
    "src/ui/editor": "ui/editor",
    "src/ui/launch": "ui/launch",
    "src/ui/run": "ui/review",
    "src/ui/shell": "ui/shell",
    "src/ui/theme": "ui/primitives",
    "src/ui/MetaParts.tsx": "ui/primitives",
    "src/ui/MetaParts.test.tsx": "ui/primitives",
    "src/ui/OutsideMark.tsx": "ui/primitives",
    "src/ui/OutsideMark.module.css": "ui/primitives",
    "src/ui/OutsideMark.test.tsx": "ui/primitives",
    "src/ui/cx.ts": "ui/primitives",
    "src/ui/keys.ts": "ui/primitives",
    "src/ui/keys.test.ts": "ui/primitives",
    "src/ui/panel.module.css": "ui/primitives",
    "src/ui/shared.module.css": "ui/primitives",
    "src/ui/useCutBottom.ts": "ui/primitives",
    "src/ui/useCutBottom.test.tsx": "ui/primitives",
    "src/ui/useFocusOnMount.ts": "ui/primitives",
    "src/ui/useScreen.ts": "ui/primitives",
    "src/ui/useStore.ts": "ui/primitives",
    "src/ui/useTheme.ts": "ui/shell",
    "src/app/reviewState.ts": "app/review",
    "src/app/reviewLifecycle.test.ts": "app/review",
    "src/test": "test",
    "src/adapters": "adapters/bridge",
    "src/ui": "ui/shell",
    "src/main.tsx": "root",
    "src/model/shared/marks.ts": "model/shared",
    "src/model/graph": "model/graph",
    "src/ui/graph": "ui/graph",
    "src/app/sessionStore.test.ts": "app/session",
    "src/app/routeModules.ts": "app/shell",
    "src/app/editorSave.ts": "app/editor",
    "src/ui/pairing": "ui/session",
    "src/adapters/clock.ts": "adapters/browser"
  },
  "features": {
    "src/ui": "primitives",
    "src/ui/theme": "theme",
    "src/ui/shell": "shell",
    "src/ui/home": "workspace",
    "src/ui/pairing": "session",
    "src/ui/plant": "plant",
    "src/ui/editor": "editor",
    "src/ui/launch": "launch",
    "src/ui/run": "review",
    "src/ui/graph": "graph"
  },
  "css": {
    "globalEntrypoints": [
      "src/ui/theme/tokens.css",
      "src/ui/theme/base.css",
      "src/ui/theme/families.css"
    ],
    "globalOwners": [
      "src/ui/shared.module.css",
      "src/ui/panel.module.css"
    ],
    "vendorFiles": [
      "src/ui/graph/internal/vendor.module.css"
    ],
    "defaultCap": 300,
    "caps": {
      "src/ui/graph/internal/nodes.module.css": {
        "cap": 300,
        "phase": "P5"
      },
      "src/ui/run/RunScreen.module.css": {
        "cap": 608,
        "phase": "P5"
      },
      "src/ui/plant/PlantScreen.module.css": {
        "cap": 314,
        "phase": "P5"
      },
      "src/ui/home/HomeScreen.module.css": {
        "cap": 434,
        "phase": "P5"
      },
      "src/ui/editor/Editor.module.css": {
        "cap": 330,
        "phase": "P5"
      },
      "src/ui/run/Scrubber.module.css": {
        "cap": 272,
        "phase": "P5"
      },
      "src/ui/launch/LaunchPanel.module.css": {
        "cap": 230,
        "phase": "P5"
      }
    },
    "globalCaps": {
      "src/ui/graph/internal/nodes.module.css": {
        "global": 0,
        "important": 0,
        "phase": "P5"
      },
      "src/ui/graph/internal/vendor.module.css": {
        "global": 6,
        "important": 2,
        "phase": "P1"
      },
      "src/ui/shared.module.css": {
        "global": 3,
        "important": 0,
        "phase": "P5"
      },
      "src/ui/plant/PlantScreen.module.css": {
        "global": 2,
        "important": 0,
        "phase": "P1"
      },
      "src/ui/run/RunScreen.module.css": {
        "global": 2,
        "important": 0,
        "phase": "P5"
      },
      "src/ui/home/HomeScreen.module.css": {
        "global": 0,
        "important": 2,
        "phase": "P5"
      }
    },
    "colorExceptions": {
      "src/ui/shared.module.css": {
        "literals": 2,
        "reason": "a mask gradient uses black as an alpha mask, not a semantic colour",
        "phase": "P5"
      }
    }
  },
  "floors": {
    "src/model/**": {
      "lines": 90,
      "functions": 90,
      "branches": 85,
      "statements": 90
    },
    "src/app/**": {
      "lines": 80,
      "functions": 80,
      "branches": 75,
      "statements": 80
    }
  },
  "rules": {
    "actionNames": [
      "clock.advance",
      "component.example",
      "component.examples",
      "component.list",
      "component.new",
      "component.show",
      "domain.compose",
      "effector.invoke",
      "fault.inject",
      "run.end",
      "run.report",
      "run.verify",
      "scenario.export",
      "world.create",
      "world.destroy"
    ],
    "protocolOwner": "adapters",
    "protocolProductionOnly": true,
    "restrictedAppImports": [
      "react",
      "react-dom",
      "react/jsx-runtime",
      "@xyflow/react",
      "lucide-react"
    ],
    "restrictedAppGlobals": [
      "window",
      "document",
      "localStorage",
      "EventSource",
      "fetch",
      "globalThis"
    ],
    "clockGlobals": [
      "setTimeout",
      "setInterval",
      "clearTimeout",
      "clearInterval",
      "requestAnimationFrame",
      "performance",
      "Date"
    ],
