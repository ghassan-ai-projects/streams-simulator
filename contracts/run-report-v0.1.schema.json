{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streams-simulator.local/schemas/run-report-v0.1.schema.json",
  "title": "Streams Simulator Run Report v0.1",
  "description": "The report `streamsim report <run-dir>` prints: one document summarising a run folder, a pure function of its files. It carries truth (seed, faults, perturbations, drop reasons, real effector outcomes), so the truth object is present only for a sealed run or an Explore run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "verification", "replay", "counts", "open_questions"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "complete", "ended", "unblinded"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["evaluate", "explore"]},
        "complete": {"type": "boolean"},
        "incomplete_reason": {"type": "string", "minLength": 1},
        "ended": {"type": "boolean", "description": "True when run.json exists: the run ended and its truth may be read."},
        "unblinded": {"type": "boolean"},
        "sim_version": {"type": "string"},
        "domain": {"$ref": "#/$defs/reference"},
        "adapter": {"$ref": "#/$defs/reference"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615, "description": "Present only with the truth object."},
        "sink": {"type": "string"},
        "time_mode": {"type": "string"},
        "start_time_ns": {"type": "integer"},
        "end_time_ns": {"type": "integer"},
        "requested_end_ns": {"type": "integer", "exclusiveMinimum": 0, "description": "Present when run.json recorded a plan: the simulated instant the run was asked to reach. Compare with end_time_ns to see how far it got."},
        "rate": {"type": "number", "exclusiveMinimum": 0, "description": "Present when run.json recorded a paced plan: simulated seconds per wall second. Absent when the plan ran as fast as possible or no plan was recorded."},
        "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$", "description": "Present when run.json recorded a plan with a name: the operator's name for the run. Authored text, not evidence."},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$", "description": "Present when run.json recorded a plan with a purpose: the question the run is meant to answer. Authored text, not evidence."},
        "termination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "at_ns"],
          "description": "Present when run.json recorded why the run stopped.",
          "properties": {
            "reason": {"enum": ["completed", "stopped_by_operator"]},
            "at_ns": {"type": "integer"}
          }
        },
        "entity_count": {"type": "integer", "minimum": 0}
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "description": "Digests exactly as run.json recorded them; one the run did not record is absent.",
      "properties": {
        "world": {"$ref": "#/$defs/digest"},
        "trace": {"$ref": "#/$defs/digest"},
        "journal": {"$ref": "#/$defs/digest"},
        "sealed_journal": {"$ref": "#/$defs/digest"},
        "ledger": {"$ref": "#/$defs/digest"},
        "history": {"$ref": "#/$defs/digest"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "description": "Whether the files in the folder agree with the digests the run recorded. Not a replay: `streamsim verify` is.",
      "properties": {
        "status": {"enum": ["files_match", "files_differ", "not_checked"]},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": {"enum": ["trace", "journal", "sealed_journal", "journal_file", "sealed_journal_file", "ledger", "history", "field_trace", "interrupt_log"]},
              "status": {"enum": ["match", "mismatch", "missing_file", "digest_missing"], "description": "digest_missing: run.json records no usable digest for the file (absent, empty or malformed) although the run ended complete; the run cannot be verified from its files."},
              "recorded": {"$ref": "#/$defs/digest", "description": "Absent for digest_missing."},
              "computed": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "Whether the recording was replayed (`streamsim report --replay`) and what the replay found. `not_checked` is the default: the report reads files and does not replay.",
      "properties": {
        "status": {"enum": ["not_checked", "reproduces", "does_not_reproduce", "incomplete"]},
        "detail": {"type": "string", "minLength": 1, "description": "Why a replay did not reproduce, or why none could run."}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emitted": {"type": "integer", "minimum": 0},
        "observed": {"type": "integer", "minimum": 0},
        "ledger_rows": {"type": "integer", "minimum": 0},
        "delivered": {"type": "integer", "minimum": 0},
        "dropped": {"type": "integer", "minimum": 0},
        "delivered_by_reason": {"$ref": "#/$defs/reason_counts"},
        "dropped_by_reason": {"$ref": "#/$defs/reason_counts"}
      }
    },
    "truth_unavailable": {"type": "string", "minLength": 1, "description": "Present when the truth object is absent, with the reason: `sealed until the run ends` for a run still open in evaluate mode (no run.json), or the reason a file of the folder belongs to another run than the journals."},
    "torn_tail": {"type": "array", "minItems": 1, "items": {"enum": ["journal.jsonl", "sealed/journal.jsonl", "ledger.jsonl"]}, "description": "Files whose last line was cut short, as by a crash, and was dropped."},
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faults", "perturbations", "environment", "effector_calls"],
      "properties": {
        "faults": {
          "description": "Every fault the run injected, as the interval the world gave it, in injection order. cleared_ns is the instant the world ended the fault (null when it is still active at the end of the run); cleared_by says which of the clear command, the pulse's own duration or an effector responder ended it.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fault_id", "entity_id", "fault", "injected_at_ns", "onset_ns", "cleared_ns", "cleared_by"],
            "properties": {
              "fault_id": {"type": "string", "minLength": 1},
              "entity_id": {"type": "string", "minLength": 1},
              "fault": {"type": "string", "minLength": 1},
              "injected_at_ns": {"type": "integer"},
              "onset_ns": {"type": "integer"},
              "cleared_ns": {"type": ["integer", "null"]},
              "cleared_by": {"enum": ["command", "pulse_end", "responder", null]}
            }
          }
        },
        "perturbations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "at_ns", "action"],
            "properties": {
              "seq": {"type": "integer", "minimum": 0},
              "at_ns": {"type": "integer"},
              "action": {"enum": ["apply", "clear"]},
              "perturbation": {"type": "string"},
              "perturb_id": {"type": "string"},
              "from_ns": {"type": "integer"},
              "until_ns": {"type": "integer"},
              "params": {"type": "object"}
            }
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "at_ns", "target", "fault"],
            "properties": {
              "seq": {"type": "integer", "minimum": 0},
              "at_ns": {"type": "integer"},
              "target": {"type": "string"},
              "fault": {"type": "string"},
              "params": {"type": "object"}
            }
          }
        },
        "effector_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "at_ns", "command_id", "effector"],
            "properties": {
              "seq": {"type": "integer", "minimum": 0},
              "at_ns": {"type": "integer"},
              "command_id": {"type": "string"},
              "effector": {"type": "string"},
              "entity_id": {"type": "string"},
              "args": {"type": "object"},
              "outcome": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "accepted": {"type": "boolean"},
                  "mode": {"type": "string"},
                  "effect_applied": {"type": "boolean"},
                  "ack_latency_ms": {"type": "number"},
                  "refusal": {"type": "string"}
                }
              }
            }
          }
        },
        "kpis": {
          "type": "object",
          "description": "The run's KPI truth from its sealed journal (domain-spec v0.2 section 29): the true mean, minimum and maximum of every KPI state, and the ISA-18.2 KPIs of every alarm state and of the alarm system.",
          "required": ["from_ns", "to_ns", "entities", "alarm_system"],
          "properties": {
            "from_ns": {"type": "integer"},
            "to_ns": {"type": "integer"},
            "entities": {"type": "array", "items": {"type": "object", "required": ["entity_id"]}},
            "alarm_system": {"type": "object", "required": ["activations", "peak_per_10_min", "flood_intervals", "chattering", "stale", "standing_at_end"]}
          }
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "arm": {"type": "string"},
        "config_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["scored", "not_scored", "failed"]},
        "reason": {"type": "string", "minLength": 1},
        "scorecard": {"type": "object"}
      }
    },
    "open_questions": {
      "type": "array",
      "description": "What a reader cannot conclude from this run, asked by rules of the binary in a fixed order. Every entry is a stable code and a sentence.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"enum": ["evidence_foreign", "evaluate_unsealed", "run_not_ended", "run_incomplete", "stopped_early", "files_differ", "replay_not_checked", "replay_does_not_reproduce", "no_observations", "torn_tail", "no_kpi_results", "no_outside_scoring"]},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "reason_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
  }
}
