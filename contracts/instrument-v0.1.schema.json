{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ghassan-ai-projects/streams-simulator/contracts/instrument-v0.1.schema.json",
  "title": "instrument-v0.1",
  "description": "A reusable sensor: attached at a measurement point it becomes a channel (COMPONENTS_V0_1.md §3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "tag",
    "unit_family",
    "unit",
    "channel"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}$"
    },
    "unit_family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "unit": {
      "type": "string",
      "pattern": "^[A-Za-z%][A-Za-z0-9%/._^-]{0,15}$"
    },
    "range": {
      "$ref": "#/$defs/range"
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_type",
        "resolution",
        "cadence",
        "noise"
      ],
      "description": "The channel members the instrument decides; the members follow domain-spec v0.2 channels.",
      "properties": {
        "value_type": {
          "enum": [
            "number",
            "counter",
            "boolean",
            "string"
          ]
        },
        "resolution": {
          "type": "number",
          "minimum": 0
        },
        "fidelity": {
          "enum": [
            "F0",
            "F1",
            "F2",
            "F3"
          ]
        },
        "absence": {
          "enum": [
            "heartbeat",
            "signal",
            "normal",
            "ambiguous"
          ]
        },
        "cadence": {
          "type": "object"
        },
        "noise": {
          "type": "object"
        },
        "drift": {
          "type": "object"
        },
        "availability": {
          "type": "object"
        },
        "link_delay": {
          "type": "object"
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "form"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
            "maxLength": 16
          },
          "form": {
            "enum": [
              "offset",
              "drift",
              "stuck",
              "freeze",
              "dropout",
              "scale",
              "noise"
            ],
            "description": "offset and drift act through a hidden bias state (COMPONENTS §3); stuck, freeze, dropout, scale and noise are observation faults (domain-spec v0.2 §25)."
          },
          "magnitude": {
            "type": "number",
            "description": "offset: in the instrument's unit (a span fraction with scaling span); drift: per hour."
          },
          "is_negative_class": {
            "type": "boolean"
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "drift: the time to full drift."
          },
          "stuck_at": {
            "enum": [
              "low",
              "high"
            ],
            "description": "stuck: the end of the channel's converted range the reading sticks at."
          },
          "factor": {
            "type": "number",
            "minimum": 0,
            "description": "scale: the gain at full fault; noise: the noise multiplier at full fault."
          },
          "quality": {
            "enum": [
              "good",
              "suspect",
              "out_of_range",
              "stale",
              "disconnected"
            ],
            "description": "The quality the channel reports while an observation fault acts."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "form": {
                  "const": "drift"
                }
              }
            },
            "then": {
              "required": [
                "duration_s",
                "magnitude"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "form": {
                  "const": "offset"
                }
              }
            },
            "then": {
              "required": [
                "magnitude"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "form": {
                  "const": "stuck"
                }
              }
            },
            "then": {
              "required": [
                "stuck_at"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "form": {
                  "enum": [
                    "scale",
                    "noise"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "factor"
              ]
            }
          }
        ]
      }
    },
    "scaling": {
      "enum": [
        "absolute",
        "span"
      ],
      "description": "span: noise sigma and fault magnitudes are fractions of the point's span."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}/[a-z][a-z0-9-]{1,31}$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    }
  }
}
