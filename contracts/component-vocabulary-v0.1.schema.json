{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ghassan-ai-projects/streams-simulator/contracts/component-vocabulary-v0.1.schema.json",
  "title": "component-vocabulary-v0.1",
  "description": "Units, unit families, port types and ISA-5.1 tag letters a component library uses (COMPONENTS_V0_1.md \u00a76). The built-in vocabulary is components/vocabulary.json; a custom library may add entries in its own file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_families"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "unit_families": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "base",
          "units"
        ],
        "properties": {
          "base": {
            "$ref": "#/$defs/unit"
          },
          "units": {
            "type": "object",
            "description": "Each unit converts to the base unit as base = scale * value + offset.",
            "propertyNames": {
              "$ref": "#/$defs/unit"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scale"
              ],
              "properties": {
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "offset": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "port_types": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,19}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_family"
        ],
        "properties": {
          "unit_family": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          }
        }
      }
    },
    "tag_letters": {
      "type": "object",
      "description": "ISA-5.1 instrument letters and the unit families each may measure.",
      "propertyNames": {
        "pattern": "^[A-Z]{1,3}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measures"
        ],
        "properties": {
          "measures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,31}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "string",
      "pattern": "^[A-Za-z%][A-Za-z0-9%/._^-]{0,15}$"
    }
  }
}
