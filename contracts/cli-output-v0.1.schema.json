{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streams-simulator.local/schemas/cli-output-v0.1.schema.json",
  "title": "Streams Simulator CLI output v0.1",
  "description": "The single JSON document a non-exempt streamsim command prints on stdout: the command's success document, or an error document. Each command's success shape is a $defs entry; tests validate real outputs against the entry for their command.",
  "oneOf": [
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/catalog_list"
    },
    {
      "$ref": "#/$defs/catalog_describe"
    },
    {
      "$ref": "#/$defs/catalog_coverage"
    },
    {
      "$ref": "#/$defs/domain_validate"
    },
    {
      "$ref": "#/$defs/domain_format"
    },
    {
      "$ref": "#/$defs/domain_lint"
    },
    {
      "$ref": "#/$defs/domain_compose"
    },
    {
      "$ref": "#/$defs/component_list"
    },
    {
      "$ref": "#/$defs/component_show"
    },
    {
      "$ref": "#/$defs/component_validate"
    },
    {
      "$ref": "#/$defs/adapter_list"
    },
    {
      "$ref": "#/$defs/adapter_verify"
    },
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/replay"
    },
    {
      "$ref": "#/$defs/suite"
    },
    {
      "$ref": "#/$defs/score"
    },
    {
      "$ref": "#/$defs/refconsumer"
    },
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/scenario_export"
    },
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/report_written"
    },
    {
      "$ref": "#/$defs/plantwire_node"
    },
    {
      "$ref": "#/$defs/plantwire_host"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "usage_invalid",
                "file_not_found",
                "domain_not_found",
                "adapter_not_found",
                "domain_invalid",
                "adapter_invalid",
                "scenario_invalid",
                "artifact_invalid",
                "component_invalid",
                "composition_invalid",
                "replay_mismatch",
                "domain_lint",
                "adapter_verify_failed",
                "io_failed",
                "catalog_failed",
                "domain_failed",
                "adapter_failed",
                "run_failed",
                "replay_failed",
                "verify_failed",
                "suite_failed",
                "score_failed",
                "manifest_failed",
                "refconsumer_failed",
                "device_failed",
                "scenario_failed",
                "report_failed",
                "component_failed",
                "plantwire_failed"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "issues": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message"
                ],
                "properties": {
                  "pointer": {
                    "type": "string",
                    "pattern": "^(/([^~/]|~[01])*)*$"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "result": {
              "type": "object"
            }
          }
        }
      }
    },
    "catalog_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "version",
              "axes",
              "stresses"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "axes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stresses": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "catalog_describe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "spec"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "spec": {
          "type": "object",
          "required": [
            "id",
            "version",
            "title"
          ]
        }
      }
    },
    "catalog_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_axis",
        "thin"
      ],
      "properties": {
        "by_axis": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "thin": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "domain_validate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "id",
        "digest",
        "channels",
        "faults",
        "effectors"
      ],
      "properties": {
        "valid": {
          "const": true
        },
        "id": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "channels": {
          "type": "integer",
          "minimum": 0
        },
        "faults": {
          "type": "integer",
          "minimum": 0
        },
        "effectors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "domain_format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatted",
        "changed",
        "digest"
      ],
      "properties": {
        "formatted": {
          "type": "string",
          "minLength": 1
        },
        "changed": {
          "type": "boolean"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "domain_lint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "digest",
        "seed",
        "hours",
        "samples",
        "findings",
        "errors",
        "warnings"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 2
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "code",
              "entity",
              "at_s",
              "detail"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "code": {
                "enum": [
                  "non_finite",
                  "out_of_range",
                  "pinned_at_bound",
                  "not_settled",
                  "conservation_residual"
                ]
              },
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "fault": {
                "type": "string",
                "minLength": 1
              },
              "at_s": {
                "type": "number",
                "minimum": 0
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "adapter_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapters"
      ],
      "properties": {
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "encoding",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "encoding": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "adapter_verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "schema_checked",
        "schema_ok",
        "golden_checked",
        "golden_match",
        "records"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "schema_checked": {
          "type": "boolean"
        },
        "schema_ok": {
          "type": "boolean"
        },
        "golden_checked": {
          "type": "boolean"
        },
        "golden_match": {
          "type": "boolean"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "first_divergence": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "trace_digest",
        "reproducible",
        "emitted",
        "ledger"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_digest": {
          "$ref": "#/$defs/digest"
        },
        "reproducible": {
          "type": "boolean"
        },
        "emitted": {
          "type": "integer",
          "minimum": 0
        },
        "ledger": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matches",
        "version_match",
        "got",
        "want",
        "first_divergence",
        "detail"
      ],
      "properties": {
        "matches": {
          "type": "boolean"
        },
        "version_match": {
          "type": "boolean"
        },
        "got": {
          "type": "string"
        },
        "want": {
          "type": "string"
        },
        "first_divergence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "detail": {
          "type": "string"
        },
        "domain_changed": {
          "type": "boolean"
        },
        "current_domain_digest": {
          "type": "string"
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "scenarios",
        "trivial_excluded",
        "terminal_state"
      ],
      "properties": {
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "scenarios": {
          "type": "integer",
          "minimum": 0
        },
        "trivial_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_state": {
          "type": "string"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "bundle",
        "run_id",
        "domain",
        "ground_truth",
        "reproducible",
        "unblinded",
        "negative_class",
        "instrument",
        "consumer",
        "loop",
        "judgment"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "bundle": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "scenario_id": {
          "type": "string"
        },
        "ground_truth": {
          "type": [
            "object",
            "null"
          ]
        },
        "reproducible": {
          "type": "boolean"
        },
        "unblinded": {
          "type": "boolean"
        },
        "negative_class": {
          "type": "boolean"
        },
        "instrument": {
          "type": "object"
        },
        "consumer": {
          "type": "object"
        },
        "loop": {
          "type": "object"
        },
        "judgment": {
          "type": "object"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "refconsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict_written",
        "detections"
      ],
      "properties": {
        "verdict_written": {
          "type": "string",
          "minLength": 1
        },
        "detections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_written",
        "signed",
        "sim"
      ],
      "properties": {
        "manifest_written": {
          "type": "string",
          "minLength": 1
        },
        "signed": {
          "type": "boolean"
        },
        "sim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenario_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_written",
        "commands",
        "omitted",
        "refused"
      ],
      "properties": {
        "scenario_written": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run",
        "verification",
        "counts"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "run": {
          "type": "object"
        },
        "digests": {
          "type": "object"
        },
        "verification": {
          "type": "object"
        },
        "counts": {
          "type": "object"
        },
        "truth": {
          "type": "object"
        },
        "consumer": {
          "type": "object"
        },
        "scoring": {
          "type": "object"
        }
      }
    },
    "report_written": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_written",
        "format"
      ],
      "properties": {
        "report_written": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "json",
            "markdown"
          ]
        }
      }
    },
    "plantwire_node": {
      "type": "object",
      "description": "plantwire node: the run the node served and the folder of its artifact and journal.",
      "required": [
        "run_id",
        "out"
      ],
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string"
        },
        "out": {
          "type": "string"
        }
      }
    },
    "plantwire_host": {
      "type": "object",
      "description": "plantwire host: the reference host's report.",
      "required": [
        "quarantined",
        "rebirths",
        "commands"
      ],
      "additionalProperties": false,
      "properties": {
        "refused": {
          "type": "string"
        },
        "quarantined": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rebirths": {
          "type": "integer",
          "minimum": 0
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "receipts"
            ],
            "properties": {
              "receipts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "result": {
                "type": "string"
              },
              "denied": {
                "type": "string",
                "description": "Why the host did not send the command: the device was quarantined or never born."
              },
              "verified": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "component_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "title",
        "class",
        "tags",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "equipment",
            "instrument"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "component_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component_summary"
          }
        }
      }
    },
    "component_show": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "document"
      ],
      "properties": {
        "entry": {
          "$ref": "#/$defs/component_summary"
        },
        "document": {
          "type": "object"
        }
      }
    },
    "component_validate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "directories",
        "equipment",
        "instruments"
      ],
      "properties": {
        "valid": {
          "const": true
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "equipment": {
          "type": "integer",
          "minimum": 0
        },
        "instruments": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "domain_compose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "channels",
        "faults",
        "effectors"
      ],
      "description": "The composed domain's summary, as domain validate reports it; composed names the file written by --out, otherwise domain carries the composed spec.",
      "properties": {
        "id": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "channels": {
          "type": "integer",
          "minimum": 0
        },
        "faults": {
          "type": "integer",
          "minimum": 0
        },
        "effectors": {
          "type": "integer",
          "minimum": 0
        },
        "composed": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "object"
        }
      }
    }
  }
}
