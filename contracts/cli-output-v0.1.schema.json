{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streams-simulator.local/schemas/cli-output-v0.1.schema.json",
  "title": "Streams Simulator CLI output v0.1",
  "description": "The single JSON document a non-exempt streamsim command prints on stdout: the command's success document, or an error document. Each command's success shape is a $defs entry; tests validate real outputs against the entry for their command.",
  "oneOf": [
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/catalog_list"
    },
    {
      "$ref": "#/$defs/catalog_describe"
    },
    {
      "$ref": "#/$defs/catalog_coverage"
    },
    {
      "$ref": "#/$defs/domain_validate"
    },
    {
      "$ref": "#/$defs/domain_format"
    },
    {
      "$ref": "#/$defs/domain_lint"
    },
    {
      "$ref": "#/$defs/domain_compose"
    },
    {
      "$ref": "#/$defs/component_list"
    },
    {
      "$ref": "#/$defs/component_show"
    },
    {
      "$ref": "#/$defs/component_validate"
    },
    {
      "$ref": "#/$defs/kind_validate"
    },
    {
      "$ref": "#/$defs/kind_twin"
    },
    {
      "$ref": "#/$defs/kind_suggest"
    },
    {
      "$ref": "#/$defs/kind_capture"
    },
    {
      "$ref": "#/$defs/component_examples"
    },
    {
      "$ref": "#/$defs/component_example"
    },
    {
      "$ref": "#/$defs/component_new"
    },
    {
      "$ref": "#/$defs/adapter_list"
    },
    {
      "$ref": "#/$defs/adapter_verify"
    },
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/replay"
    },
    {
      "$ref": "#/$defs/suite"
    },
    {
      "$ref": "#/$defs/score"
    },
    {
      "$ref": "#/$defs/refconsumer"
    },
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/scenario_export"
    },
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/report_written"
    },
    {
      "$ref": "#/$defs/plantwire_node"
    },
    {
      "$ref": "#/$defs/plantwire_host"
    },
    {
      "$ref": "#/$defs/plantwire_relay"
    },
    {
      "$ref": "#/$defs/plantwire_replay"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "usage_invalid",
                "file_not_found",
                "domain_not_found",
                "adapter_not_found",
                "domain_invalid",
                "adapter_invalid",
                "scenario_invalid",
                "artifact_invalid",
                "component_invalid",
                "composition_invalid",
                "replay_mismatch",
                "domain_lint",
                "adapter_verify_failed",
                "io_failed",
                "catalog_failed",
                "domain_failed",
                "adapter_failed",
                "run_failed",
                "replay_failed",
                "verify_failed",
                "suite_failed",
                "score_failed",
                "manifest_failed",
                "refconsumer_failed",
                "device_failed",
                "scenario_failed",
                "report_failed",
                "component_failed",
                "kind_failed",
                "plantwire_failed"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "issues": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message"
                ],
                "properties": {
                  "pointer": {
                    "type": "string",
                    "pattern": "^(/([^~/]|~[01])*)*$"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "keyword": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Why the issue exists, for a program: the JSON Schema keyword that failed (type, enum, pattern, required, additionalProperties, minimum, ...) or a stable rule code of the binary (twin_member_required, twin_unit_required, twin_instrument_mismatch, twin_name_pattern, twin_range, domain_rule, implements_drift, ...). Never parse message."
                  },
                  "member": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The named member the rule is about (resolution, writable, safe_stop, unit, ...), present when the rule is about one."
                  }
                }
              }
            },
            "result": {
              "type": "object"
            }
          }
        }
      }
    },
    "catalog_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "version",
              "axes",
              "stresses"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "axes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stresses": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "catalog_describe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "spec"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "spec": {
          "type": "object",
          "required": [
            "id",
            "version",
            "title"
          ]
        }
      }
    },
    "catalog_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_axis",
        "thin"
      ],
      "properties": {
        "by_axis": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "thin": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "implements_checked": {
      "type": "array",
      "description": "The kind files the domain was checked against: one entry per domain kind that implements a kind file, with the digest of that kind file. Empty when no kind of the domain implements one, so an empty list means there was nothing to check, never that the check was skipped.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "kind_digest"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "kind_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "domain_validate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "id",
        "digest",
        "channels",
        "faults",
        "effectors",
        "implements_checked"
      ],
      "properties": {
        "implements_checked": {
          "$ref": "#/$defs/implements_checked"
        },
        "valid": {
          "const": true
        },
        "id": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "channels": {
          "type": "integer",
          "minimum": 0
        },
        "faults": {
          "type": "integer",
          "minimum": 0
        },
        "effectors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "domain_format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatted",
        "changed",
        "digest"
      ],
      "properties": {
        "formatted": {
          "type": "string",
          "minLength": 1
        },
        "changed": {
          "type": "boolean"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "domain_lint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "digest",
        "seed",
        "hours",
        "samples",
        "findings",
        "errors",
        "warnings"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 2
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "code",
              "entity",
              "at_s",
              "detail"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "code": {
                "enum": [
                  "non_finite",
                  "out_of_range",
                  "pinned_at_bound",
                  "not_settled",
                  "conservation_residual"
                ]
              },
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "fault": {
                "type": "string",
                "minLength": 1
              },
              "at_s": {
                "type": "number",
                "minimum": 0
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "adapter_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapters"
      ],
      "properties": {
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "encoding",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "encoding": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "adapter_verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "schema_checked",
        "schema_ok",
        "golden_checked",
        "golden_match",
        "records"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "schema_checked": {
          "type": "boolean"
        },
        "schema_ok": {
          "type": "boolean"
        },
        "golden_checked": {
          "type": "boolean"
        },
        "golden_match": {
          "type": "boolean"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "first_divergence": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "trace_digest",
        "reproducible",
        "emitted",
        "ledger",
        "implements_checked"
      ],
      "properties": {
        "implements_checked": {
          "$ref": "#/$defs/implements_checked"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_digest": {
          "$ref": "#/$defs/digest"
        },
        "reproducible": {
          "type": "boolean"
        },
        "emitted": {
          "type": "integer",
          "minimum": 0
        },
        "ledger": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matches",
        "version_match",
        "got",
        "want",
        "first_divergence",
        "detail",
        "reason",
        "emitted",
        "incomplete"
      ],
      "properties": {
        "matches": {
          "type": "boolean",
          "description": "True only when the run is verified: it ended complete and the replay and every evidence file agree with what run.json recorded. A run that ended incomplete is never a match."
        },
        "version_match": {
          "type": "boolean"
        },
        "got": {
          "type": "string"
        },
        "want": {
          "type": "string"
        },
        "first_divergence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "detail": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "match",
            "recorded_spec",
            "world_digest",
            "trace_divergence",
            "journal_divergence",
            "evidence_divergence",
            "unblinded_stamp",
            "digest_missing",
            "file_differs",
            "file_missing",
            "incomplete",
            "incomplete_stamp"
          ],
          "description": "Why the result is what it is: match, or the first cause found. recorded_spec: a recorded domain or adapter spec does not match its digest (nothing replayed). world_digest: the recorded specs replay to another world than the recorded world digest. trace_divergence: the replayed trace differs from the recorded trace digest. journal_divergence: a replayed journal stream differs from its recorded digest. evidence_divergence: the replayed ledger or history differs from its recorded digest (file names it). unblinded_stamp: the replay disagrees with the artifact on unblinding. digest_missing: a closed run's run.json records no digest for the file. file_differs: the file on disk differs from its recorded digest or from the replay. file_missing: the file is absent from the run folder. incomplete: the run ended incomplete (`incomplete` is true), so it cannot be verified as complete; matches is false even when the replay and every file it recorded agree. incomplete_stamp: the incomplete stamp of run.json contradicts the evidence (a journal closed with another incomplete value, or an incomplete run recorded as reproducible); file names the journal when a journal contradicts it."
        },
        "file": {
          "type": "string",
          "description": "The run-folder file the reason names, relative to the run folder; present for digest_missing, file_differs, file_missing, evidence_divergence and, when a journal contradicts the stamp, incomplete_stamp."
        },
        "emitted": {
          "type": "integer",
          "minimum": 0,
          "description": "Events the replay emitted."
        },
        "incomplete": {
          "type": "boolean",
          "description": "run.json says the run ended incomplete (a sink failure or a consumer that did not quiesce). verify never reports such a run as matching."
        },
        "journal_diverged": {
          "type": "array",
          "items": {"enum": ["observer", "director"]},
          "uniqueItems": true,
          "description": "The journal streams (observer is journal.jsonl, director is sealed/journal.jsonl) that differ from the replay; omitted when none does."
        },
        "domain_changed": {
          "type": "boolean"
        },
        "current_domain_digest": {
          "type": "string"
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "scenarios",
        "trivial_excluded",
        "terminal_state"
      ],
      "properties": {
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "scenarios": {
          "type": "integer",
          "minimum": 0
        },
        "trivial_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_state": {
          "type": "string"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "bundle",
        "run_id",
        "domain",
        "ground_truth",
        "reproducible",
        "unblinded",
        "negative_class",
        "instrument",
        "consumer",
        "loop",
        "judgment"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "bundle": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "scenario_id": {
          "type": "string"
        },
        "ground_truth": {
          "type": [
            "object",
            "null"
          ]
        },
        "reproducible": {
          "type": "boolean"
        },
        "unblinded": {
          "type": "boolean"
        },
        "negative_class": {
          "type": "boolean"
        },
        "instrument": {
          "type": "object"
        },
        "consumer": {
          "type": "object"
        },
        "loop": {
          "type": "object"
        },
        "judgment": {
          "type": "object"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "refconsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict_written",
        "detections"
      ],
      "properties": {
        "verdict_written": {
          "type": "string",
          "minLength": 1
        },
        "detections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_written",
        "signed",
        "sim"
      ],
      "properties": {
        "manifest_written": {
          "type": "string",
          "minLength": 1
        },
        "signed": {
          "type": "boolean"
        },
        "sim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenario_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_written",
        "commands",
        "omitted",
        "refused"
      ],
      "properties": {
        "scenario_written": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run",
        "verification",
        "counts"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "run": {
          "type": "object"
        },
        "digests": {
          "type": "object"
        },
        "verification": {
          "type": "object"
        },
        "counts": {
          "type": "object"
        },
        "truth": {
          "type": "object"
        },
        "consumer": {
          "type": "object"
        },
        "scoring": {
          "type": "object"
        }
      }
    },
    "report_written": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_written",
        "format"
      ],
      "properties": {
        "report_written": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "json",
            "markdown"
          ]
        }
      }
    },
    "plantwire_node": {
      "type": "object",
      "description": "plantwire node: the run the node served and the folder of its artifact and journal.",
      "required": [
        "run_id",
        "out"
      ],
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string"
        },
        "out": {
          "type": "string"
        }
      }
    },
    "plantwire_host": {
      "type": "object",
      "description": "plantwire host: the reference host's report.",
      "required": [
        "quarantined",
        "rebirths",
        "commands"
      ],
      "additionalProperties": false,
      "properties": {
        "refused": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "Which rule an environment_mismatch refusal broke; absent for any other refusal."
        },
        "quarantined": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rebirths": {
          "type": "integer",
          "minimum": 0
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "receipts"
            ],
            "properties": {
              "receipts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "result": {
                "type": "string"
              },
              "denied": {
                "type": "string",
                "description": "Why the host did not send the command: the device was quarantined or never born."
              },
              "verified": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "plantwire_relay": {
      "type": "object",
      "description": "plantwire relay: what the relay carried between a gateway and the real host until it was interrupted.",
      "required": [
        "gateway_sessions",
        "host_sessions",
        "up",
        "down",
        "dropped"
      ],
      "additionalProperties": false,
      "properties": {
        "gateway_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "host_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "up": {
          "type": "integer",
          "minimum": 0,
          "description": "Records sent to the host, the relay's own deaths included."
        },
        "down": {
          "type": "integer",
          "minimum": 0,
          "description": "Records sent to the gateway, the relay's own rebirth requests and offline states included."
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "description": "Records received and not relayed: invalid, duplicate, from the wrong session, of a type that does not travel that way, or with no host to take them."
        },
        "refused": {
          "type": "string",
          "description": "The refusal the relay gave a gateway at its handshake."
        },
        "reason": {
          "type": "string",
          "description": "Which rule an environment_mismatch refusal broke; absent for any other refusal."
        },
        "host_refused": {
          "type": "string",
          "description": "The refusal the host gave the relayed session."
        },
        "to_simulated": {
          "type": "integer",
          "minimum": 0,
          "description": "Mixed session only: records handed to the simulated world, the relay's own states and rebirth requests included."
        },
        "from_simulated": {
          "type": "integer",
          "minimum": 0,
          "description": "Mixed session only: records the simulated world sent up to the host."
        },
        "unknown_device": {
          "type": "integer",
          "minimum": 0,
          "description": "Mixed session only: commands the relay refused with unknown_device because no board of the node holds the device."
        }
      }
    },
    "plantwire_replay": {
      "type": "object",
      "description": "plantwire replay-trace: what a replayed field trace played to a host. The node announced itself and every board as simulated.",
      "required": [
        "records",
        "skipped",
        "barriers",
        "commands_refused",
        "field_trace_digest",
        "session_id"
      ],
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "integer",
          "minimum": 0,
          "description": "Records sent to the host, the births and the replay's own death included."
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Recorded records the replay did not play: invalid, duplicate, before the first NBIRTH, or of a type that is not replayed (barriers, receipts, results, deaths)."
        },
        "barriers": {
          "type": "integer",
          "minimum": 0,
          "description": "Barriers the host answered."
        },
        "commands_refused": {
          "type": "integer",
          "minimum": 0,
          "description": "Commands the host sent that the replay refused; a replay controls no device."
        },
        "field_trace_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "session_id": {
          "type": "string"
        }
      }
    },
    "component_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "title",
        "class",
        "tags",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "equipment",
            "instrument"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "An instrument's unit."
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "description": "An instrument's measuring range.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "match": {
          "enum": [
            "exact",
            "convertible"
          ],
          "description": "Only with component list --unit: whether the instrument measures in the asked unit or in a convertible one."
        },
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok"
          ],
          "description": "Only with component list --unit: whether a twin can read a metric of that unit (and of --min to --max when given) through this instrument. A conversion between units is not a refusal.",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "code": {
              "enum": [
                "unit_incompatible",
                "range_unstated",
                "range_narrower",
                "reading_not_number"
              ],
              "description": "Why the instrument does not fit; absent when it does."
            },
            "member": {
              "enum": [
                "unit",
                "eu_range",
                "data_type"
              ],
              "description": "The member of the metric the reason is about; absent when the instrument fits."
            }
          }
        }
      }
    },
    "component_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component_summary"
          }
        }
      }
    },
    "component_examples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examples"
      ],
      "properties": {
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "component_example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "example"
      ],
      "properties": {
        "example": {
          "type": "object"
        }
      }
    },
    "component_new": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition"
      ],
      "properties": {
        "composition": {
          "type": "object"
        }
      }
    },
    "component_show": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "document"
      ],
      "properties": {
        "entry": {
          "$ref": "#/$defs/component_summary"
        },
        "document": {
          "type": "object"
        }
      }
    },
    "component_validate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "directories",
        "equipment",
        "instruments"
      ],
      "properties": {
        "valid": {
          "const": true
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "equipment": {
          "type": "integer",
          "minimum": 0
        },
        "instruments": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "kind_validate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "kinds"
      ],
      "properties": {
        "valid": {
          "const": true
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind",
              "kind_digest",
              "metrics",
              "commands"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "kind_digest": {
                "$ref": "#/$defs/digest"
              },
              "metrics": {
                "type": "integer",
                "minimum": 0
              },
              "commands": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "kind_suggest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choices"
      ],
      "description": "A valid twin-choices-v0.1 document with the binary's defaults for the kind files; nothing is written.",
      "properties": {
        "choices": {
          "type": "object"
        }
      }
    },
    "kind_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "boards",
        "bd_seq",
        "births_seen",
        "taken",
        "kinds"
      ],
      "description": "The kinds a node announced in one NBIRTH, as draft kind files; nothing is written. A birth is a claim: the document exists only when every announced kind_digest was recomputed and held, and `environment` and each board's `environment` are the node's claims as well, never verified (a node whose claim contradicts its boards is refused). The first birth found is the one taken; births_seen and later_births say what else the source held, and `issues` what the scan found beside the kinds (birth_line_unreadable, rebirth_differs, capability_digest_mismatch, scan_truncated). comparison is present only when a kinds directory was given.",
      "properties": {
        "environment": {
          "enum": [
            "simulated",
            "hardware",
            "mixed"
          ],
          "description": "What the node claims; the binary does not verify it. A birth whose claim contradicts its boards is refused."
        },
        "boards": {
          "type": "array",
          "description": "The boards the node announced, each with the environment it claims (the origin of every device born on it); a claim, never verified.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "board",
              "environment"
            ],
            "properties": {
              "board": {
                "type": "string"
              },
              "environment": {
                "enum": [
                  "simulated",
                  "hardware"
                ]
              }
            }
          }
        },
        "bd_seq": {
          "type": "integer",
          "minimum": 0
        },
        "births_seen": {
          "type": "integer",
          "minimum": 1,
          "description": "NBIRTH records found in the source (a lower bound when issues holds scan_truncated)."
        },
        "taken": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line",
            "bd_seq"
          ],
          "description": "Where the captured birth stands in the source: the first, never the last.",
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "bd_seq": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "later_births": {
          "type": "array",
          "minItems": 1,
          "description": "The births after the taken one (at most 64): whether their kinds equal the taken one's.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "bd_seq",
              "same_content"
            ],
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "bd_seq": {
                "type": "integer",
                "minimum": 0
              },
              "same_content": {
                "type": "boolean"
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "description": "What the source and the birth show beside the kinds, in the shape of an error document's issues.",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "kind_digest",
              "draft",
              "claims"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "kind_digest": {
                "$ref": "#/$defs/digest"
              },
              "draft": {
                "type": "object",
                "description": "The NBIRTH.kinds entry without kind_digest: the content of a kind file, to be reviewed before it is saved."
              },
              "claims": {
                "type": "array",
                "description": "Pointers into the draft of the members that came from the board and that nothing has verified: risk_class and safe_stop of each command and every bound of an args_schema.",
                "items": {
                  "type": "string",
                  "pattern": "^(/([^~/]|~[01])*)*$"
                }
              },
              "issues": {
                "type": "array",
                "minItems": 1,
                "description": "What the draft still breaks as a kind file, and what its comparison found (kind_name_collision, kind_file_unreadable).",
                "items": {
                  "$ref": "#/$defs/issue"
                }
              },
              "comparison": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "target"
                ],
                "description": "The draft against the kind file of the same name in the kinds directory: new (no such file), same (equal kind_digest), differs (differs_at is the pointer of the first differing member, as the implements check names it) or unreadable (the file of that name cannot be read). target is the path the draft would be saved to: the existing file's path, the colliding file's when the name differs only in case (collides_with), else kinds-dir/<kind name, ':' as '_'>.kind.json.",
                "properties": {
                  "status": {
                    "enum": [
                      "new",
                      "same",
                      "differs",
                      "unreadable"
                    ]
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file_digest": {
                    "$ref": "#/$defs/digest"
                  },
                  "differs_at": {
                    "type": "string",
                    "pattern": "^(/([^~/]|~[01])*)*$"
                  },
                  "collides_with": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^(/([^~/]|~[01])*)*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "keyword": {
          "type": "string",
          "minLength": 1
        },
        "member": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "kind_twin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "channels",
        "faults",
        "effectors",
        "implements"
      ],
      "description": "The scaffolded twin's summary, as domain validate reports it, and the kind files it implements; composed names the file written by --out, otherwise domain carries the twin's spec.",
      "properties": {
        "id": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "channels": {
          "type": "integer",
          "minimum": 0
        },
        "faults": {
          "type": "integer",
          "minimum": 0
        },
        "effectors": {
          "type": "integer",
          "minimum": 0
        },
        "implements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "composed": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "object"
        }
      }
    },
    "domain_compose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "channels",
        "faults",
        "effectors"
      ],
      "description": "The composed domain's summary, as domain validate reports it; composed names the file written by --out, otherwise domain carries the composed spec.",
      "properties": {
        "id": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "channels": {
          "type": "integer",
          "minimum": 0
        },
        "faults": {
          "type": "integer",
          "minimum": 0
        },
        "effectors": {
          "type": "integer",
          "minimum": 0
        },
        "composed": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "object"
        }
      }
    }
  }
}
