{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-stream.local/schemas/trace-record-v0.1.schema.json",
  "title": "Agentic Stream V0.1 Trace Record",
  "description": "The wire format the agentic-stream output adapter renders into: flat dotted keys under a record_type discriminator. Vendored here so `streamsim adapter verify` can prove the adapter correct with Agentic Stream absent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type"],
  "properties": {
    "record_type": {
      "enum": ["runtime_config", "event", "trace_end"],
      "description": "Discriminates the three record families: the preamble config header, per-event projections, and the end-of-trace horizon."
    },
    "runtime_version": {"type": "string"},
    "storage_schema_version": {"type": "integer", "minimum": 1},
    "max_episodes_per_hour": {"type": "integer", "minimum": 0},
    "until": {"type": "string", "format": "date-time"},
    "event.id": {"type": "string", "pattern": "^evt-[0-9]{6}$"},
    "event.entity_type": {"type": "string"},
    "event.entity_id": {"type": "string", "maxLength": 128},
    "event.type": {"type": "string"},
    "event.event_time": {"type": "string", "format": "date-time"},
    "event.arrival_time": {"type": "string", "format": "date-time"},
    "event.value": {},
    "event.unit": {"type": "string", "maxLength": 32}
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "event"}}, "required": ["record_type"]},
      "then": {
        "required": ["event.id", "event.entity_type", "event.entity_id", "event.type", "event.event_time", "event.arrival_time"]
      }
    },
    {
      "if": {"properties": {"record_type": {"const": "runtime_config"}}, "required": ["record_type"]},
      "then": {"required": ["runtime_version", "storage_schema_version", "max_episodes_per_hour"]}
    },
    {
      "if": {"properties": {"record_type": {"const": "trace_end"}}, "required": ["record_type"]},
      "then": {"required": ["until"]}
    }
  ]
}
