{
  "schema_version": "0.1",
  "id": "streamsim/rtd",
  "version": 1,
  "title": "RTD temperature transmitter (Pt100, 4-20 mA)",
  "description": "Platinum resistance thermometer with a head transmitter; slow, accurate, prone to offset after a bad termination and to slow drift.",
  "tag": "TT",
  "unit_family": "temperature",
  "unit": "degC",
  "range": {
    "min": -50,
    "max": 200
  },
  "channel": {
    "value_type": "number",
    "resolution": 0.1,
    "fidelity": "F1",
    "absence": "signal",
    "cadence": {
      "mode": "periodic",
      "period_s": 10
    },
    "noise": {
      "model": "gaussian",
      "sigma": 0.05
    }
  },
  "faults": [
    {
      "id": "offset",
      "form": "offset",
      "magnitude": 2.0
    },
    {
      "id": "drift",
      "form": "drift",
      "magnitude": 0.05,
      "duration_s": 86400
    }
  ]
}
