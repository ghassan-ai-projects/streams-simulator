{
  "schema_version": "0.1",
  "id": "streamsim/mass-flow-meter",
  "version": 1,
  "title": "Coriolis or density-compensated mass flow meter",
  "description": "Mass flow meter on a steam or gas line, reporting kg/s; offset after a bad zero.",
  "tag": "FT",
  "unit_family": "mass_flow",
  "unit": "kg/s",
  "channel": {
    "value_type": "number",
    "resolution": 0.001,
    "fidelity": "F1",
    "absence": "signal",
    "cadence": {
      "mode": "periodic",
      "period_s": 5
    },
    "noise": {
      "model": "gaussian",
      "sigma": 0.003
    }
  },
  "faults": [
    {
      "id": "offset",
      "form": "offset",
      "magnitude": 0.02
    },
    {
      "id": "drift",
      "form": "drift",
      "magnitude": 0.0005,
      "duration_s": 172800
    }
  ],
  "scaling": "span"
}
