{
  "schema_version": "0.1",
  "id": "streamsim/power-meter",
  "version": 1,
  "title": "Three-phase power meter",
  "description": "Revenue-grade three-phase meter reporting active power; a wrong CT ratio shows as a constant offset.",
  "tag": "JT",
  "unit_family": "power",
  "unit": "kW",
  "channel": {
    "value_type": "number",
    "resolution": 0.1,
    "fidelity": "F1",
    "absence": "signal",
    "cadence": {
      "mode": "periodic",
      "period_s": 15
    },
    "noise": {
      "model": "gaussian",
      "sigma": 0.002
    }
  },
  "faults": [
    {
      "id": "offset",
      "form": "offset",
      "magnitude": 0.05
    }
  ],
  "scaling": "span"
}
