{
  "schema_version": "0.1",
  "id": "streamsim/level-radar",
  "version": 1,
  "title": "Non-contact radar level transmitter (80 GHz)",
  "description": "Radar level transmitter on a tank: millimetre accuracy, immune to the fluid; a false echo from an agitator or the nozzle holds it at the top, foam and turbulence widen the noise.",
  "tag": "LT",
  "unit_family": "level",
  "unit": "m",
  "range": {
    "min": 0,
    "max": 30
  },
  "channel": {
    "value_type": "number",
    "resolution": 0.001,
    "fidelity": "F1",
    "absence": "signal",
    "cadence": {
      "mode": "periodic",
      "period_s": 10
    },
    "noise": {
      "model": "gaussian",
      "sigma": 0.0005
    },
    "availability": {
      "uptime": 0.999,
      "mttr_s": 600
    }
  },
  "faults": [
    {
      "id": "offset",
      "form": "offset",
      "magnitude": 0.01
    },
    {
      "id": "false_echo",
      "form": "stuck",
      "stuck_at": "high"
    },
    {
      "id": "echo_lost",
      "form": "dropout"
    },
    {
      "id": "foam",
      "form": "noise",
      "factor": 15,
      "quality": "suspect"
    },
    {
      "id": "tank_height",
      "form": "scale",
      "factor": 0.97
    }
  ],
  "scaling": "span"
}
