{
  "schema_version": "0.1",
  "id": "streamsim/control-valve",
  "version": 1,
  "title": "Pneumatic control valve with positioner",
  "description": "Control valve driven by a command: the stem follows the command except inside a stiction band, flow is the opening characteristic times the supply pressure effect. Sticking widens the band, so the stem lags the command in steps; positioner drift offsets the stem; plugging cuts flow at the same position.",
  "class": "rotating/valve/control_valve",
  "tags": [
    "fluids",
    "utilities",
    "valve"
  ],
  "icon": "valve",
  "kind": {
    "state": [
      {
        "name": "position_setpoint",
        "unit": "%",
        "initial": 47.0013,
        "min": 0,
        "max": 100
      },
      {
        "name": "position",
        "unit": "%",
        "initial": 47.0013,
        "min": 0,
        "max": 100
      },
      {
        "name": "positioner_offset",
        "unit": "%",
        "initial": 0
      },
      {
        "name": "friction_gain",
        "unit": "ratio",
        "initial": 1,
        "min": 0.02,
        "max": 1
      },
      {
        "name": "upstream_pressure",
        "unit": "kPa",
        "initial": 400,
        "min": 0
      },
      {
        "name": "actual_position",
        "unit": "%",
        "initial": 47.0013
      },
      {
        "name": "command_error",
        "unit": "%",
