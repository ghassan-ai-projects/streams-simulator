#!/usr/bin/env bash
# The ci-check test tier: the whole suite once in short mode, shuffled, with
# -tags simdet (the wall clock removed, so a deterministic package cannot read
# time) and cheap `set` coverage; the floors are checked from this run's
# output. Long simulations (hours of plant time, every library component) skip
# in short mode and run on demand (make test-long); the race detector runs on
# demand too (make test-race).
set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

report=$(mktemp -d)
trap 'rm -rf "$report"' EXIT

go test -tags simdet -short -shuffle=on -count=1 -cover ./... 2>&1 | tee "$report/coverage.txt"
scripts/check-coverage "$report/coverage.txt"
